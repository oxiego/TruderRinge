SET DATABASE COLLATION "German"
CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE CACHED TABLE "Fleischpreise_Anzahl"("Klasse" VARCHAR(10) NOT NULL PRIMARY KEY,"Tage" TINYINT NOT NULL)
CREATE CACHED TABLE "Fleischpreise_Ergebnisse_Schiesstag"("Schiesstag" TINYINT NOT NULL,"Klasse" VARCHAR(10) NOT NULL,"Platz" TINYINT NOT NULL,"SchuetzenID" NUMERIC(8) NOT NULL,"Serie" TINYINT NOT NULL,PRIMARY KEY("Schiesstag","Klasse","Platz"))
CREATE CACHED TABLE "Fleischpreise_Schiesstag"("Schiesstag" TINYINT NOT NULL,"Klasse" VARCHAR(10) NOT NULL,"Fleisch" BOOLEAN NOT NULL,PRIMARY KEY("Schiesstag","Klasse"))
CREATE CACHED TABLE "LG_Diepold_WP"("Saison" NUMERIC(8) NOT NULL,"Platz" TINYINT,"SchuetzenID" NUMERIC(8) NOT NULL,"Teiler" NUMERIC(4,1) NOT NULL,"Jugend" BOOLEAN NOT NULL,"Klasse" VARCHAR(50),PRIMARY KEY("Saison","SchuetzenID"))
CREATE CACHED TABLE "LG_Einteilung_Klassen"("Saison" NUMERIC(4) NOT NULL,"SchuetzenID" NUMERIC(8) NOT NULL,"Nummer" VARCHAR(3) NOT NULL,"Klasse" VARCHAR(10) NOT NULL,PRIMARY KEY("Saison","SchuetzenID"))
CREATE CACHED TABLE "LG_Ergebnisse_Schiesstag"("Saison" NUMERIC(4) NOT NULL,"Schiesstag" TINYINT NOT NULL,"SchuetzenID" NUMERIC(8) NOT NULL,"Serie1" TINYINT NOT NULL,"Serie2" TINYINT NOT NULL,"Serie3" TINYINT NOT NULL,"Serie4" TINYINT NOT NULL,"Ergebnis" SMALLINT NOT NULL,"Pokal" NUMERIC(4,1),"Programm_2" NUMERIC(4,1),PRIMARY KEY("Saison","Schiesstag","SchuetzenID"))
CREATE CACHED TABLE "LG_Geldpreise"("Saison" NUMERIC(10) NOT NULL,"Schiesstag" TINYINT NOT NULL,"SchuetzenID" NUMERIC(8) NOT NULL,"Plazierung_Serie" TINYINT,"Serie" TINYINT,"Plazierung_Teiler" TINYINT,"Teiler" NUMERIC(4,1),"Betrag" DECIMAL(5,2),"Jugend" BOOLEAN NOT NULL,PRIMARY KEY("Saison","Schiesstag","SchuetzenID"))
CREATE CACHED TABLE "LG_Geldpreise_Bericht"("Schiesstag" TINYINT NOT NULL,"Platz_S" TINYINT NOT NULL,"Name_Serie" VARCHAR(100),"Serie" TINYINT,"Platz_T" TINYINT,"Name_Teiler" VARCHAR(100),"Teiler" NUMERIC(4,1),"Klasse" VARCHAR(50) NOT NULL,PRIMARY KEY("Schiesstag","Platz_S","Klasse"))
CREATE CACHED TABLE "LG_Jahresschnitt"("Saison" NUMERIC(4) NOT NULL,"SchuetzenID" NUMERIC(8) NOT NULL,"Jahresschnitt" DECIMAL(5,2) NOT NULL,PRIMARY KEY("Saison","SchuetzenID"))
CREATE CACHED TABLE "LG_Koenigsschiessen"("Saison" NUMERIC(8) NOT NULL,"Platz" TINYINT,"SchuetzenID" NUMERIC(8) NOT NULL,"Teiler" NUMERIC(4,1) NOT NULL,"Klasse" VARCHAR(50) NOT NULL,"Jugend" BOOLEAN NOT NULL,PRIMARY KEY("Saison","SchuetzenID"))
CREATE CACHED TABLE "LG_Roehrner_WP"("Saison" NUMERIC(4) NOT NULL,"Platz" TINYINT,"SchuetzenID" NUMERIC(8) NOT NULL,"Tage" TINYINT NOT NULL,"Geburtsdatum" DATE NOT NULL,PRIMARY KEY("Saison","SchuetzenID"))
CREATE CACHED TABLE "LG_Schmankerlpokal"("Saison" NUMERIC(8) NOT NULL,"Platz" TINYINT,"SchuetzenID" NUMERIC(8) NOT NULL,"Teiler" NUMERIC(4,1) NOT NULL,"Klasse" VARCHAR(50) NOT NULL,"Jugend" BOOLEAN NOT NULL,PRIMARY KEY("Saison","SchuetzenID"))
CREATE CACHED TABLE "LG_Schuetzen_Bericht"("Saison" NUMERIC(4) NOT NULL,"SchuetzenID" NUMERIC(8) NOT NULL,"Name" VARCHAR(255) NOT NULL,"Klasse" VARCHAR(10) NOT NULL,"Platz_Vereinsmeister" TINYINT,"Jahresschnitt" NUMERIC(5,2),"Vorjahr" NUMERIC(5,2),"Differenz" NUMERIC(5,2),"Platz_Koenig" TINYINT,"Teiler_Koenig" NUMERIC(4,1),"Platz_Pokalteiler" TINYINT,"Teiler_Pokalteiler" NUMERIC(5,2),"Platz_Roehrner" TINYINT,"Tage_Roehrner" TINYINT,"Platz_Schmankerlpokal" TINYINT,"Teiler_Schmankerlpokal" NUMERIC(4,1),"Fleisch_Platz1" VARCHAR(10),"Fleisch_Platz2" VARCHAR(10),"Fleisch_Platz3" VARCHAR(10),"Geldpreis" NUMERIC(5,2),"Platz_Diepold" TINYINT,"Teiler_Diepold" NUMERIC(8,1),PRIMARY KEY("Saison","SchuetzenID"))
