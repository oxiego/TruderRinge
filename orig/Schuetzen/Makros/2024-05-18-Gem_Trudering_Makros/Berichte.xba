<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE script:module PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "module.dtd">
<script:module xmlns:script="http://openoffice.org/2000/script" script:name="Berichte" script:language="StarBasic">REM ***** Makros zum Exportieren der Berichte als PDF *****
Private ArgsPDF(1) As New com.sun.star.beans.PropertyValue   	&apos;Array zum Exportieren von Berichten
Private Dispatcher As Object

REM ***** Makro zum Exportieren der Luftgewehr Tagesergebnisse *****
Sub SaveAsPDF_LG_Tagesauswertung(oReport AS OBJECT)

	DIM stUrl AS STRING

	ArgsPDF(0).Name = &quot;FilterName&quot;
	ArgsPDF(0).Value = &quot;writer_pdf_Export&quot;

	stUrl = docURL + gSaison + &quot;/&quot; + gSaison + &quot;-&quot; + Format(gSchiesstag, &quot;##00&quot;) + &quot;_LG_Tagesergebnisse&quot; + &quot;_&quot; + sDatum + &quot;.pdf&quot;

	oReport.storeToURL(stUrl, ArgsPDF())	

End Sub

