REM ***** Auswertung Königsschiessen
Sub Auswertung_Koenig(ByVal sTyp As String)

	Dim mSchuetze() As Variant
	Dim iZaehler As Integer
	Dim i As Integer
	Dim Document As Object
	Dim ReportDoc As Object
	Dim Args(1) As New com.sun.star.beans.PropertyValue			&apos;Array zum Öffnen von Formularen/Berichten
	Dim ArgsPrint(1) As New com.sun.star.beans.PropertyValue   	&apos;Array zum Drucken von Berichten
	
	REM ***** Initialisierung des Arrays zum Öffnen von Formularen/Berichten
	Args(0).Name = &quot;ActiveConnection&quot;
	Args(0).Value = Connection
	Args(1).Name = &quot;OpenMode&quot;
	Args(1).Value = &quot;open&quot;

	REM ***** Initialisierung des Druckers
&apos;	Document = ThisComponent
&apos;	Prop = Document.getPrinter()

	REM ***** Initialisierung des Arrays zum Drucken von Berichten
&apos;	ArgsPrint(0).name = &quot;Name&quot;               
&apos;	ArgsPrint(0).value = &quot;&lt;&quot; &amp; Prop(0).value &amp; &quot;&gt;&quot;      
&apos;	ArgsPrint(1).name = &quot;Wait&quot;               
&apos;	ArgsPrint(1).value = True                  
	
	REM ***** Auswertung Erwachsene
	Query = &quot;SELECT * FROM &quot;&quot;Koenigsschiessen&quot;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;Jugend&quot;&quot; = &apos;FALSE&apos; ORDER BY &quot;&quot;Teiler&quot;&quot; ASC&quot;
	ResultSet = Statement.executeQuery(Query)

	ResultSet.last()

	REM ***** Überprüfe, ob ein Ergebnis geliefert wurde *****
	If ResultSet.getrow() &gt; 0 Then

		iZaehler = ResultSet.getrow()
		ReDim mSchuetze(iZaehler - 1)

		For i = 1 to iZaehler
	
			REM ***** Speichere Schuetzen in Array
			ResultSet.absolute(i)
	
			mSchuetze(i-1) = ResultSet.getInt(3)

		Next i

		For i = 1 to iZaehler
	
			REM ***** Schreibe Platzierung Koenigsschiessen
			Query = &quot;UPDATE &quot;&quot;Koenigsschiessen&quot;&quot; SET &quot;&quot;Platz&quot;&quot; = &quot;&amp; i &amp;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i-1) &amp;&quot;&quot;
			Statement.executeUpdate(Query)

		Next i
	Else

		REM ***** Keine Daten vorhanden
		MsgBox &quot;Keine Daten für Auswertung &quot;&amp; sTyp &amp;&quot; König  (Schützen) vorhanden!&quot;, 32, &quot;Hinweis&quot;
		
	End If

	REM ***** Auswertung Jugend
	Query = &quot;SELECT * FROM &quot;&quot;Koenigsschiessen&quot;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;Jugend&quot;&quot; = &apos;TRUE&apos; ORDER BY &quot;&quot;Teiler&quot;&quot; ASC&quot;
	ResultSet = Statement.executeQuery(Query)

	ResultSet.last()
	iZaehler = ResultSet.getrow()

	If iZaehler &gt; 0 Then

		ReDim  mSchuetze(iZaehler - 1)

		For i = 1 to iZaehler
	
			REM ***** Speichere Schuetzen in Array
			ResultSet.absolute(i)
	
			mSchuetze(i-1) = ResultSet.getInt(3)

		Next i

		For i = 1 to iZaehler
	
			REM ***** Schreibe Platzierung Koenigsschiessen
			Query = &quot;UPDATE &quot;&quot;Koenigsschiessen&quot;&quot; SET &quot;&quot;Platz&quot;&quot; = &quot;&amp; i &amp;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i-1) &amp;&quot;&quot;
			Statement.executeUpdate(Query)

		Next i
	Else

		REM ***** Keine Daten vorhanden
		MsgBox &quot;Keine Daten für Auswertung &quot;&amp; sTyp &amp;&quot; König (Jugend) vorhanden!&quot;, 32, &quot;Hinweis&quot;

	End If

	REM ***** Bericht öffnen
	ReportDoc = DataSource.DatabaseDocument.ReportDocuments.loadComponentFromURL(&quot;Koenigsschiessen&quot;,&quot;_blank&quot;, 0, Args())
	
	REM ***** Bericht drucken *****
&apos;	ReportDoc.print(ArgsPrint())

	REM ***** Bericht als PDF speichern *****
	Call SaveAsPDF_Koenigsschiessen(ReportDoc)

	REM ***** Bericht schließen *****
	ReportDoc.close(true)

End Sub

REM ***** Auswertung Vereinsmeisterschaft
Sub Auswertung_Vereinsmeister(ByVal sTyp As String)

	Dim mKlasse() As String
	Dim mSchuetze() As Variant
	Dim iZaehler, nZaehler, rZaehler, zZaehler As Integer
	Dim i, n, r, z As Integer
	Dim Vorjahr, Jahresschnitt, Differenz As Double
	Dim Erg As Integer
	Dim Document As Object
	Dim ReportDoc As Object
	Dim Args(1) As New com.sun.star.beans.PropertyValue			&apos;Array zum Öffnen von Formularen/Berichten
	Dim ArgsPrint(1) As New com.sun.star.beans.PropertyValue   	&apos;Array zum Drucken von Berichten
	
	REM ***** Initialisierung des Arrays zum Öffnen von Formularen/Berichten
	Args(0).Name = &quot;ActiveConnection&quot;
	Args(0).Value = Connection
	Args(1).Name = &quot;OpenMode&quot;
	Args(1).Value = &quot;open&quot;

	REM ***** Initialisierung des Druckers
&apos;	Document = ThisComponent
&apos;	Prop = Document.getPrinter()

	REM ***** Initialisierung des Arrays zum Drucken von Berichten
&apos;	ArgsPrint(0).name = &quot;Name&quot;               
&apos;	ArgsPrint(0).value = &quot;&lt;&quot; &amp; Prop(0).value &amp; &quot;&gt;&quot;      
&apos;	ArgsPrint(1).name = &quot;Wait&quot;               
&apos;	ArgsPrint(1).value = True                  
	
	REM ***** Suche alle aktiven Klassen
	Query = &quot;SELECT &quot;&quot;Klasse&quot;&quot; FROM &quot;&quot;Schuetzenklassen&quot;&quot; WHERE &quot;&amp; sTyp &amp;&quot; = TRUE AND &quot;&quot;Aktiv&quot;&quot; = TRUE ORDER BY &quot;&quot;Klasse&quot;&quot; ASC&quot;	
	ResultSet = Statement.executeQuery(Query)

	ResultSet.last()
	iZaehler = ResultSet.getrow()
		
	If iZaehler &gt; 0 Then

		ReDim mKlasse(iZaehler - 1)
	
		For i = 1 to iZaehler
	
			REM ***** Speichere Schuetzenklassen in Array
			ResultSet.absolute(i)
	
			mKlasse(i-1) = ResultSet.getString(1)

		Next i

		For i = 0 to iZaehler - 1
		
			REM ***** Suche alle aktiven Schuetzen der Schützenklasse 
			Query = &quot;SELECT &quot;&quot;SchuetzenID&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;, &quot;&quot;Schuetzen&quot;&quot; WHERE &quot;&quot;Klasse&quot;&quot; = &apos;&quot;&amp; mKlasse(i) &amp;&quot;&apos; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;SchuetzenID&quot;&quot; = &quot;&quot;Schuetzen&quot;&quot;.&quot;&quot;SchuetzenID&quot;&quot; AND &quot;&quot;Schuetzen&quot;&quot;.&quot;&quot;Aktiv&quot;&quot; = TRUE&quot;	
			ResultSet = Statement.executeQuery(Query)

			ResultSet.last()
			nZaehler = ResultSet.getrow()

			If nZaehler &gt; 0 Then
			
				ReDim mSchuetze(nZaehler - 1,3)

				For n = 1 to nZaehler
			
					REM ***** Speichere Schuetzen in Array
					ResultSet.absolute(n)
			
					mSchuetze(n-1,0) = ResultSet.getInt(1)
		
				Next n

				For n = 0 to nZaehler - 1

					REM ***** Suche alle Schiessergebnisse des Schuetzen in der aktuellen Saision 
					Query = &quot;SELECT &quot;&quot;Ergebnis&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Ergebnisse_Schiesstag&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(n,0) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;	
					ResultSet = Statement.executeQuery(Query)

					ResultSet.last()
					rZaehler = ResultSet.getrow()

					REM ***** Prüfe ob minimale Anzahl von Schiesstagen erreicht wurden
					If rZaehler &gt;= MinErgDefault Then
						
						REM ***** Initialisiere Variable
						Jahresschnitt = 0
						Erg = 0
							
						For r = 1 to rZaehler
						
							ResultSet.absolute(r)

							REM ***** Zähle Ergebnisse zusammen
							Erg = Erg + ResultSet.getInt(1)
							
						Next r
					
						REM ***** Berechne Jahresschnitt
						Jahresschnitt = Erg / rZaehler

						REM ***** Schreibe Jahresschnitt in Array
						mSchuetze(n,1) = Jahresschnitt
						
						REM ***** Lese Vorjahresschnitt des Schuetzen aus
						Query = &quot;SELECT &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Vorjahresschnitt&quot;&quot; FROM &quot;&quot;Schuetzen&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(n,0) &amp;&quot;&quot;	
						ResultSet = Statement.executeQuery(Query)

						ResultSet.last()
						Vorjahr = ResultSet.getDouble(1)
						
						If Vorjahr &gt; 0 Then

							REM ***** Berechne Differenz
							Diff = Jahresschnitt - Vorjahr

						Else

							Vorjahr = 0
							Diff  = 0

						End If		

						REM ***** Schreibe Vorjahresschnitt in Array
						mSchuetze(n,2) = Vorjahr

						
						REM ***** Schreibe Differenz in Array
						mSchuetze(n,3) = Diff

						REM ***** Schreibe Daten in LG_Vereinsmeister
						Query = &quot;INSERT INTO &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Vereinsmeister&quot;&quot; (&quot;&quot;Saison&quot;&quot;,&quot;&quot;Klasse&quot;&quot;, &quot;&quot;SchuetzenID&quot;&quot;,&quot;&quot;Jahresschnitt&quot;&quot;,&quot;&quot;Vorjahr&quot;&quot;, &quot;&quot;Differenz&quot;&quot;) VALUES (&quot;&amp; gSaison &amp;&quot;, &apos;&quot;&amp; mKlasse(i) &amp;&quot;&apos;, &quot;&amp; mSchuetze(n,0) &amp;&quot;, &quot;&amp; Str(mSchuetze(n,1)) &amp;&quot;, &quot;&amp; Str(mSchuetze(n,2)) &amp;&quot;, &quot;&amp; Str(mSchuetze(n,3)) &amp;&quot;)&quot; 
						Statement.executeUpdate(Query)

					End If
					
				Next n

				REM ***** Lese Schuetzen sortiert nach Jahresschnitt aus
				Query = &quot;SELECT &quot;&quot;SchuetzenID&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Vereinsmeister&quot;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;Klasse&quot;&quot; = &apos;&quot;&amp; mKlasse(i) &amp;&quot;&apos; ORDER BY &quot;&quot;Jahresschnitt&quot;&quot; DESC&quot; 
				ResultSet = Statement.executeQuery(Query)

				ResultSet.last()
				zZaehler = ResultSet.getrow()

				If zZaehler &gt; 0 Then
				
					ReDim mSchuetze(zZaehler - 1)
					
					For z = 1 to zZaehler
				
						REM ***** Speichere Schuetzen in Array
						ResultSet.absolute(z)
				
						mSchuetze(z-1) = ResultSet.getInt(1)
			
					Next z

					For z = 0 to zZaehler -1
			
						REM ***** Schreibe Platzierung in LG_Vereinsmeister Tabelle
						Query = &quot;UPDATE &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Vereinsmeister&quot;&quot; SET &quot;&quot;Platz&quot;&quot; = &quot;&amp; z + 1 &amp;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(z) &amp;&quot;&quot;
						Statement.executeUpdate(Query)

					Next z
				End If
			End If
		Next i
	End If

	REM ***** Bericht öffnen
	ReportDoc = DataSource.DatabaseDocument.ReportDocuments.loadComponentFromURL(sTyp &amp;&quot;_Vereinsmeister&quot;,&quot;_blank&quot;, 0, Args())
	
	REM ***** Bericht drucken *****
&apos;	ReportDoc.print(ArgsPrint())

	REM ***** Bericht als PDF speichern *****
	If sTyp = &quot;LG&quot; Then

		Call SaveAsPDF_LG_Vereinsmeister(ReportDoc)

	Else

		Call SaveAsPDF_LP_Vereinsmeister(ReportDoc)

	End If

	REM ***** Bericht schließen *****
	ReportDoc.close(true)

End Sub

REM ***** Auswertung Geldpreise
Sub Auswertung_Geldpreise(ByVal sTyp As String)

	Dim mKlasse() As String
	Dim mSchuetze() As String
	Dim iZaehler, nZaehler, rZaehler As Integer
	Dim i, n, r As Integer
	Dim Erg As Double
	Dim Document As Object
	Dim ReportDoc As Object
	Dim Args(1) As New com.sun.star.beans.PropertyValue			&apos;Array zum Öffnen von Formularen/Berichten
	Dim ArgsPrint(1) As New com.sun.star.beans.PropertyValue   	&apos;Array zum Drucken von Berichten
	
	REM ***** Initialisierung des Arrays zum Öffnen von Formularen/Berichten
	Args(0).Name = &quot;ActiveConnection&quot;
	Args(0).Value = Connection
	Args(1).Name = &quot;OpenMode&quot;
	Args(1).Value = &quot;open&quot;

	REM ***** Initialisierung des Druckers
&apos;	Document = ThisComponent
&apos;	Prop = Document.getPrinter()

	REM ***** Initialisierung des Arrays zum Drucken von Berichten
&apos;	ArgsPrint(0).name = &quot;Name&quot;               
&apos;	ArgsPrint(0).value = &quot;&lt;&quot; &amp; Prop(0).value &amp; &quot;&gt;&quot;      
&apos;	ArgsPrint(1).name = &quot;Wait&quot;               
&apos;	ArgsPrint(1).value = True                  
	
	REM ***** Suche alle aktiven Klassen
	Query = &quot;SELECT &quot;&quot;Klasse&quot;&quot; FROM &quot;&quot;Schuetzenklassen&quot;&quot; WHERE &quot;&amp; sTyp &amp;&quot; = TRUE AND &quot;&quot;Aktiv&quot;&quot; = TRUE ORDER BY &quot;&quot;Klasse&quot;&quot; ASC&quot;	
	ResultSet = Statement.executeQuery(Query)

	ResultSet.last()
	iZaehler = ResultSet.getrow()
		
	If iZaehler &gt; 0 Then

		ReDim mKlasse(iZaehler - 1)
	
		For i = 1 to iZaehler
	
			REM ***** Speichere Schuetzenklassen in Array
			ResultSet.absolute(i)
	
			mKlasse(i-1) = ResultSet.getString(1)

		Next i

		For i = 0 to iZaehler - 1
		
			REM ***** Suche alle aktiven Schuetzen der Schützenklasse 
			Query = &quot;SELECT &quot;&quot;SchuetzenID&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;, &quot;&quot;Schuetzen&quot;&quot; WHERE &quot;&quot;Klasse&quot;&quot; = &apos;&quot;&amp; mKlasse(i) &amp;&quot;&apos; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;SchuetzenID&quot;&quot; = &quot;&quot;Schuetzen&quot;&quot;.&quot;&quot;SchuetzenID&quot;&quot; AND &quot;&quot;Schuetzen&quot;&quot;.&quot;&quot;Aktiv&quot;&quot; = TRUE&quot;	
			ResultSet = Statement.executeQuery(Query)

			ResultSet.last()
			nZaehler = ResultSet.getrow()

			If nZaehler &gt; 0 Then
			
				ReDim mSchuetze(nZaehler - 1)

				For n = 1 to nZaehler
			
					REM ***** Speichere Schuetzen in Array
					ResultSet.absolute(n)
			
					mSchuetze(n-1) = ResultSet.getInt(1)
		
				Next n

				For n = 0 to nZaehler - 1

					REM ***** Suche alle Schiessergebnisse des Schuetzen in der aktuellen Saision 
					Query = &quot;SELECT &quot;&quot;Betrag&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Geldpreise&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(n) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;	
					ResultSet = Statement.executeQuery(Query)

					ResultSet.last()
					rZaehler = ResultSet.getrow()

					REM ***** Initialisiere Variable
					Erg = 0
						
					For r = 1 to rZaehler
					
						ResultSet.absolute(r)

						REM ***** Zähle Beträge zusammen
						Erg = Erg + ResultSet.getDouble(1)
						
					Next r
				
					REM ***** Schreibe Daten in LG_Geldpreise_Saison
					Query = &quot;INSERT INTO &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Geldpreise_Saison&quot;&quot; (&quot;&quot;Saison&quot;&quot;,&quot;&quot;Klasse&quot;&quot;, &quot;&quot;SchuetzenID&quot;&quot;,&quot;&quot;Betrag&quot;&quot;,&quot;&quot;Tage&quot;&quot;) VALUES (&quot;&amp; gSaison &amp;&quot;, &apos;&quot;&amp; mKlasse(i) &amp;&quot;&apos;, &quot;&amp; mSchuetze(n) &amp;&quot;, &quot;&amp; Str(Erg) &amp;&quot;, &quot;&amp; rZaehler &amp;&quot;)&quot; 
					Statement.executeUpdate(Query)
	
				Next n
			End If
		Next i
	End If

	REM ***** Bericht öffnen
	ReportDoc = DataSource.DatabaseDocument.ReportDocuments.loadComponentFromURL(sTyp &amp;&quot;_Geldpreise&quot;,&quot;_blank&quot;, 0, Args())
	
	REM ***** Bericht drucken *****
&apos;	ReportDoc.print(ArgsPrint())

	REM ***** Bericht als PDF speichern *****
	If sTyp = &quot;LG&quot; Then

		Call SaveAsPDF_LG_Geldpreise(ReportDoc)

	Else

		Call SaveAsPDF_LP_Geldpreise(ReportDoc)

	End If

	REM ***** Bericht schließen *****
	ReportDoc.close(true)

End Sub

REM ***** Auswertung Pokalteiler
Sub Auswertung_Pokalteiler(ByVal sTyp As String)

	Dim mKlasse() As String
	Dim mSchuetze() As String
	Dim iZaehler, nZaehler, rZaehler, zZaehler As Integer
	Dim i, n, r, z As Integer
	DIm Teiler, Erg As Double
	Dim Document As Object
	Dim ReportDoc As Object
	Dim Args(1) As New com.sun.star.beans.PropertyValue			&apos;Array zum Öffnen von Formularen/Berichten
	Dim ArgsPrint(1) As New com.sun.star.beans.PropertyValue   	&apos;Array zum Drucken von Berichten
	
	REM ***** Initialisierung des Arrays zum Öffnen von Formularen/Berichten
	Args(0).Name = &quot;ActiveConnection&quot;
	Args(0).Value = Connection
	Args(1).Name = &quot;OpenMode&quot;
	Args(1).Value = &quot;open&quot;

	REM ***** Initialisierung des Druckers
&apos;	Document = ThisComponent
&apos;	Prop = Document.getPrinter()

	REM ***** Initialisierung des Arrays zum Drucken von Berichten
&apos;	ArgsPrint(0).name = &quot;Name&quot;               
&apos;	ArgsPrint(0).value = &quot;&lt;&quot; &amp; Prop(0).value &amp; &quot;&gt;&quot;      
&apos;	ArgsPrint(1).name = &quot;Wait&quot;               
&apos;	ArgsPrint(1).value = True                  
	
	REM ***** Suche alle aktiven Klassen
	Query = &quot;SELECT &quot;&quot;Klasse&quot;&quot; FROM &quot;&quot;Schuetzenklassen&quot;&quot; WHERE &quot;&amp; sTyp &amp;&quot; = TRUE AND &quot;&quot;Aktiv&quot;&quot; = TRUE ORDER BY &quot;&quot;Klasse&quot;&quot; ASC&quot;	
	ResultSet = Statement.executeQuery(Query)

	ResultSet.last()
	iZaehler = ResultSet.getrow()
		
	If iZaehler &gt; 0 Then

		ReDim mKlasse(iZaehler - 1)
	
		For i = 1 to iZaehler
	
			REM ***** Speichere Schuetzenklassen in Array
			ResultSet.absolute(i)
	
			mKlasse(i - 1) = ResultSet.getString(1)

		Next i

		For i = 0 to iZaehler - 1
		
			REM ***** Suche alle aktiven Schuetzen der Schützenklasse 
			Query = &quot;SELECT &quot;&quot;SchuetzenID&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;, &quot;&quot;Schuetzen&quot;&quot; WHERE &quot;&quot;Klasse&quot;&quot; = &apos;&quot;&amp; mKlasse(i) &amp;&quot;&apos; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;SchuetzenID&quot;&quot; = &quot;&quot;Schuetzen&quot;&quot;.&quot;&quot;SchuetzenID&quot;&quot; AND &quot;&quot;Schuetzen&quot;&quot;.&quot;&quot;Aktiv&quot;&quot; = TRUE&quot;	
			ResultSet = Statement.executeQuery(Query)

			ResultSet.last()
			nZaehler = ResultSet.getrow()

			If nZaehler &gt; 0 Then
			
				ReDim mSchuetze(nZaehler - 1)

				For n = 1 to nZaehler
			
					REM ***** Speichere Schuetzen in Array
					ResultSet.absolute(n)
			
					mSchuetze(n - 1) = ResultSet.getInt(1)
		
				Next n

				For n = 0 to nZaehler - 1

					REM ***** Suche alle Pokalteiler des Schuetzen in der aktuellen Saision 
					Query = &quot;SELECT &quot;&quot;Pokal&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Ergebnisse_Schiesstag&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(n) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;Pokal&quot;&quot; IS NOT NULL AND &quot;&quot;Pokal&quot;&quot; &lt; 999.9 ORDER BY &quot;&quot;Pokal&quot;&quot; ASC&quot;	
					ResultSet = Statement.executeQuery(Query)

					ResultSet.last()
					rZaehler = ResultSet.getrow()

					If  rZaehler &gt;= 5 Then

						REM ***** Initialisiere Variable
						Erg = 0
							
						REM ***** Nimm nur die besten 5 Teiler
						For r = 1 to 5

							ResultSet.absolute(r)
	
							REM ***** Zähle Teiler zusammen
							Erg = Erg + ResultSet.getDouble(1)
						Next r
					
						REM ***** Berechne Durchnitt
						Teiler = Erg / 5
	
						REM ***** Schreibe Daten in LG_Geldpreise_Saison
						Query = &quot;INSERT INTO &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Pokalteiler&quot;&quot; (&quot;&quot;Saison&quot;&quot;,&quot;&quot;Klasse&quot;&quot;, &quot;&quot;SchuetzenID&quot;&quot;,&quot;&quot;Teiler&quot;&quot;) VALUES (&quot;&amp; gSaison &amp;&quot;, &apos;&quot;&amp; mKlasse(i) &amp;&quot;&apos;, &quot;&amp; mSchuetze(n) &amp;&quot;, &quot;&amp; Str(Teiler) &amp;&quot;)&quot; 
						Statement.executeUpdate(Query)

					End If
				Next n

				REM ***** Lese Schuetzen sortiert nach Jahresschnitt aus
				Query = &quot;SELECT &quot;&quot;SchuetzenID&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Pokalteiler&quot;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;Klasse&quot;&quot; = &apos;&quot;&amp; mKlasse(i) &amp;&quot;&apos; ORDER BY &quot;&quot;Teiler&quot;&quot; ASC&quot; 
				ResultSet = Statement.executeQuery(Query)

				ResultSet.last()
				zZaehler = ResultSet.getrow()

				If zZaehler &gt; 0 Then
				
					ReDim mSchuetze(zZaehler - 1)
					
					For z = 1 to zZaehler
				
						REM ***** Speichere Schuetzen in Array
						ResultSet.absolute(z)
				
						mSchuetze(z - 1) = ResultSet.getInt(1)
			
					Next z

					For z = 0 to zZaehler - 1
			
						REM ***** Schreibe Platzierung in LG_Vereinsmeister Tabelle
						Query = &quot;UPDATE &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Pokalteiler&quot;&quot; SET &quot;&quot;Platz&quot;&quot; = &quot;&amp; z + 1 &amp;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(z) &amp;&quot;&quot;
						Statement.executeUpdate(Query)

					Next z

				End If

			End If

		Next i

	End If

	REM ***** Bericht öffnen
	ReportDoc = DataSource.DatabaseDocument.ReportDocuments.loadComponentFromURL(sTyp &amp;&quot;_Pokalteiler&quot;,&quot;_blank&quot;, 0, Args())
	
	
	REM ***** Bericht drucken *****
&apos;	ReportDoc.print(ArgsPrint())

	REM ***** Bericht als PDF speichern *****
	If sTyp = &quot;LG&quot; Then

		Call SaveAsPDF_LG_Pokalteiler(ReportDoc)

	Else

		Call SaveAsPDF_LP_Pokalteiler(ReportDoc)

	End If

	REM ***** Bericht schließen *****
	ReportDoc.close(true)

End Sub

REM ***** Auswertung Schmankerlpokal
Sub Auswertung_Schmankerlpokal(ByVal sTyp As String)

	Dim mSchuetze() As Variant
	Dim iZaehler As Integer
	Dim i As Integer
	Dim Document As Object
	Dim ReportDoc As Object
	Dim Args(1) As New com.sun.star.beans.PropertyValue			&apos;Array zum Öffnen von Formularen/Berichten
	Dim ArgsPrint(1) As New com.sun.star.beans.PropertyValue   	&apos;Array zum Drucken von Berichten
	
	REM ***** Initialisierung des Arrays zum Öffnen von Formularen/Berichten
	Args(0).Name = &quot;ActiveConnection&quot;
	Args(0).Value = Connection
	Args(1).Name = &quot;OpenMode&quot;
	Args(1).Value = &quot;open&quot;

	REM ***** Initialisierung des Druckers
&apos;	Document = ThisComponent
&apos;	Prop = Document.getPrinter()

	REM ***** Initialisierung des Arrays zum Drucken von Berichten
&apos;	ArgsPrint(0).name = &quot;Name&quot;               
&apos;	ArgsPrint(0).value = &quot;&lt;&quot; &amp; Prop(0).value &amp; &quot;&gt;&quot;      
&apos;	ArgsPrint(1).name = &quot;Wait&quot;               
&apos;	ArgsPrint(1).value = True                  
	
	REM ***** Auswertung Erwachsene
	Query = &quot;SELECT * FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Schmankerlpokal&quot;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;Jugend&quot;&quot; = FALSE ORDER BY &quot;&quot;Teiler&quot;&quot; ASC&quot;
	ResultSet = Statement.executeQuery(Query)

	ResultSet.last()
	iZaehler = ResultSet.getrow()

	If iZaehler &gt; 0 Then

		ReDim  mSchuetze(iZaehler - 1)

		For i = 1 to iZaehler
	
			REM ***** Speichere Schuetzen in Array
			ResultSet.absolute(i)
	
			mSchuetze(i-1) = ResultSet.getInt(3)

		Next i

		For i = 1 to iZaehler
	
			REM ***** Schreibe Platzierung Schmankerlpokal
			Query = &quot;UPDATE &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Schmankerlpokal&quot;&quot; SET &quot;&quot;Platz&quot;&quot; = &quot;&amp; i &amp;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i-1) &amp;&quot;&quot;
			Statement.executeUpdate(Query)

		Next i
	Else

		REM ***** Keine Daten vorhanden
		MsgBox &quot;Keine Daten für Auswertung Schmankerlpokal (Schuetzen) vorhanden!&quot;, 32, &quot;Hinweis&quot;

	End If

	REM ***** Auswertung Jugend
	Query = &quot;SELECT * FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Schmankerlpokal&quot;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;Jugend&quot;&quot; = TRUE ORDER BY &quot;&quot;Teiler&quot;&quot; ASC&quot;
	ResultSet = Statement.executeQuery(Query)

	ResultSet.last()
	iZaehler = ResultSet.getrow()

	If iZaehler &gt; 0 Then

		ReDim  mSchuetze(iZaehler - 1)

		For i = 1 to iZaehler
	
			REM ***** Speichere Schuetzen in Array
			ResultSet.absolute(i)
	
			mSchuetze(i-1) = ResultSet.getInt(3)

		Next i

		For i = 1 to iZaehler
	
			REM ***** Schreibe Platzierung Schmankerlpokal
			Query = &quot;UPDATE &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Schmankerlpokal&quot;&quot; SET &quot;&quot;Platz&quot;&quot; = &quot;&amp; i &amp;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i-1) &amp;&quot;&quot;
			Statement.executeUpdate(Query)

		Next i
	Else

		REM ***** Keine Daten vorhanden
		MsgBox &quot;Keine Daten für Auswertung Schmankerlpokal (Jugend) vorhanden!&quot;, 32, &quot;Hinweis&quot;

	End If

	REM ***** Bericht öffnen
	ReportDoc = DataSource.DatabaseDocument.ReportDocuments.loadComponentFromURL(sTyp &amp;&quot;_Schmankerlpokal&quot;,&quot;_blank&quot;, 0, Args())
	
	REM ***** Bericht drucken *****
&apos;	ReportDoc.print(ArgsPrint())

	REM ***** Bericht als PDF speichern *****
	If sTyp = &quot;LG&quot; Then

		Call SaveAsPDF_LG_Schmankerlpokal(ReportDoc)

	Else

		Call SaveAsPDF_LP_Schmankerlpokal(ReportDoc)

	End If

	REM ***** Bericht schließen *****
	ReportDoc.close(true)

End Sub

REM ***** Auswertung Diepold Wanderpokal
Sub Auswertung_Diepold_WP(ByVal sTyp As String)

	Dim mSchuetze() As String
	Dim iZaehler, nZaehler, rZaehler, zZaehler As Integer
	Dim i, n, r, z As Integer
	Dim Teiler, Erg As Double
	Dim Klassen As String
	Dim Klassen_Jugend As String
	Dim Document As Object
	Dim ReportDoc As Object
	Dim Args(1) As New com.sun.star.beans.PropertyValue			&apos;Array zum Öffnen von Formularen/Berichten
	Dim ArgsPrint(1) As New com.sun.star.beans.PropertyValue   	&apos;Array zum Drucken von Berichten
	
	REM ***** Initialisierung des Arrays zum Öffnen von Formularen/Berichten
	Args(0).Name = &quot;ActiveConnection&quot;
	Args(0).Value = Connection
	Args(1).Name = &quot;OpenMode&quot;
	Args(1).Value = &quot;open&quot;

	REM ***** Initialisierung des Druckers
&apos;	Document = ThisComponent
&apos;	Prop = Document.getPrinter()

	REM ***** Initialisierung des Arrays zum Drucken von Berichten
&apos;	ArgsPrint(0).name = &quot;Name&quot;               
&apos;	ArgsPrint(0).value = &quot;&lt;&quot; &amp; Prop(0).value &amp; &quot;&gt;&quot;      
&apos;	ArgsPrint(1).name = &quot;Wait&quot;               
&apos;	ArgsPrint(1).value = True                  
	
	REM ***** Klassen auslesen
	Query = &quot;SELECT &quot;&quot;Klasse&quot;&quot; FROM &quot;&quot;Schuetzenklassen&quot;&quot; WHERE &quot;&amp; sTyp &amp;&quot; = TRUE AND &quot;&quot;Jugendklasse&quot;&quot; = FALSE  AND &quot;&quot;Aktiv&quot;&quot; = TRUE ORDER BY &quot;&quot;Klasse&quot;&quot; ASC&quot;	
	ResultSet = Statement.executeQuery(Query)

	ResultSet.last()
	iZaehler = ResultSet.getrow()
	
	Klassen = &quot;&quot;
	
	If iZaehler &gt; 0 Then
		ReDim mKlasse(iZaehler - 1,1)
	
		For i = 1 to iZaehler
	
			REM ***** Speichere Schuetzenklassen in Array
			ResultSet.absolute(i)
	
			mKlasse(i-1,0) = ResultSet.getString(1)
			mKlasse(i-1,1) = False
			
			If i &lt; iZaehler Then
				Klassen = Klassen + ResultSet.getString(1) + &quot; / &quot;
			Else
				Klassen = Klassen + ResultSet.getString(1)
			End If

		Next i
	End If
	
	REM ***** Klassen auslesen
	Query = &quot;SELECT &quot;&quot;Klasse&quot;&quot; FROM &quot;&quot;Schuetzenklassen&quot;&quot; WHERE &quot;&amp; sTyp &amp;&quot; = TRUE AND &quot;&quot;Jugendklasse&quot;&quot; = TRUE AND &quot;&quot;Aktiv&quot;&quot; = TRUE ORDER BY &quot;&quot;Klasse&quot;&quot; ASC&quot;	
	ResultSet = Statement.executeQuery(Query)

	ResultSet.last()
	iZaehler = ResultSet.getrow()
	
	Klassen_Jugend = &quot;&quot;
	
	If iZaehler &gt; 0 Then
		ReDim mKlasse(iZaehler - 1,1)
	
		For i = 1 to iZaehler
	
			REM ***** Speichere Schuetzenklassen in Array
			ResultSet.absolute(i)
	
			mKlasse(i-1,0) = ResultSet.getString(1)
			mKlasse(i-1,1) = False
			
			Klassen_Jugend = Klassen_Jugend + ResultSet.getString(1) + &quot; &quot;

		Next i

	End If

	REM ***** Suche alle aktiven Schuetzen ausser Jugend
	Query = &quot;SELECT &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;SchuetzenID&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;, &quot;&quot;Schuetzenklassen&quot;&quot;, &quot;&quot;Schuetzen&quot;&quot; WHERE &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;Klasse&quot;&quot; = &quot;&quot;Schuetzenklassen&quot;&quot;.&quot;&quot;Klasse&quot;&quot; AND &quot;&quot;Schuetzenklassen&quot;&quot;.&quot;&quot;Jugendklasse&quot;&quot; = FALSE AND &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;SchuetzenID&quot;&quot; = &quot;&quot;Schuetzen&quot;&quot;.&quot;&quot;SchuetzenID&quot;&quot; AND &quot;&quot;Schuetzen&quot;&quot;.&quot;&quot;Aktiv&quot;&quot; = TRUE&quot;	
	ResultSet = Statement.executeQuery(Query)

	ResultSet.last()
	nZaehler = ResultSet.getrow()

	If nZaehler &gt; 0 Then
	
		ReDim mSchuetze(nZaehler - 1,2)

		For n = 1 to nZaehler
	
			REM ***** Speichere Schuetzen in Array
			ResultSet.absolute(n)
	
			mSchuetze(n-1,0) = ResultSet.getInt(1)

		Next n

		For n = 0 to nZaehler - 1

			REM ***** Suche alle Pokalteiler des Schuetzen in der aktuellen Saision 
			Query = &quot;SELECT &quot;&quot;Pokal&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Ergebnisse_Schiesstag&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(n,0) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;Pokal&quot;&quot; IS NOT NULL AND &quot;&quot;Pokal&quot;&quot; &lt; 999.9 ORDER BY &quot;&quot;Pokal&quot;&quot; ASC&quot;	
			ResultSet = Statement.executeQuery(Query)

			ResultSet.last()
			rZaehler = ResultSet.getrow()

			If rZaehler &gt; 0 Then

				ResultSet.absolute(1)

				REM ***** Speichere niedrigsten Teiler in Array
				mSchuetze(n,1) = ResultSet.getDouble(1)
			
			Else
				
				REM ***** Keinen Teiler gefunden
				mSchuetze(n,1) = 999.9

			End If

			REM ***** Suche alle Teiler 2. Programm des Schuetzen in der aktuellen Saision 
			Query = &quot;SELECT &quot;&quot;Programm_2&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Ergebnisse_Schiesstag&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(n,0) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;Programm_2&quot;&quot; IS NOT NULL AND &quot;&quot;Programm_2&quot;&quot; &lt; 999.9 ORDER BY &quot;&quot;Programm_2&quot;&quot; ASC&quot;	
			ResultSet = Statement.executeQuery(Query)

			ResultSet.last()
			rZaehler = ResultSet.getrow()

			If  rZaehler &gt; 0 Then

				ResultSet.absolute(1)

				REM ***** Speichere niedrigsten Teiler in Array
				mSchuetze(n,2) = ResultSet.getDouble(1)

			Else
				
				REM ***** Keinen Teiler gefunden
				mSchuetze(n,2) = 999.9

			End If

			If CDbl(mSchuetze(n,1)) &lt; 999.9 OR CDbl(mSchuetze(n,2)) &lt; 999.9 Then

				REM ***** Pokalteiler &lt;= Teiler 2. Programm?
				If CDbl(mSchuetze(n,1)) &lt; CDbl(mSchuetze(n,2)) Then
	
					REM ***** Schreibe Pokalteiler in Tabelle LG_Diepold_WP
					Query = &quot;INSERT INTO &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Diepold_WP&quot;&quot; (&quot;&quot;Saison&quot;&quot;, &quot;&quot;SchuetzenID&quot;&quot;,&quot;&quot;Teiler&quot;&quot;, &quot;&quot;Jugend&quot;&quot;, &quot;&quot;Klasse&quot;&quot;) VALUES (&quot;&amp; gSaison &amp;&quot;, &quot;&amp; mSchuetze(n,0) &amp;&quot;, &apos;&quot;&amp; Str(mSchuetze(n,1)) &amp;&quot;&apos;, FALSE, &apos;&quot;&amp; Klassen &amp;&quot;&apos;)&quot; 
					Statement.executeUpdate(Query)
	
				Else
	
					REM ***** Schreibe Teiler 2. Programm in Tabelle LG_Diepold_WP
					Query = &quot;INSERT INTO &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Diepold_WP&quot;&quot; (&quot;&quot;Saison&quot;&quot;, &quot;&quot;SchuetzenID&quot;&quot;,&quot;&quot;Teiler&quot;&quot;, &quot;&quot;Jugend&quot;&quot;, &quot;&quot;Klasse&quot;&quot;) VALUES (&quot;&amp; gSaison &amp;&quot;, &quot;&amp; mSchuetze(n,0) &amp;&quot;, &apos;&quot;&amp; Str(mSchuetze(n,2)) &amp;&quot;&apos;, FALSE, &apos;&quot;&amp; Klassen &amp;&quot;&apos;)&quot; 
					Statement.executeUpdate(Query)
	
				End If
			End If
		Next n

		REM ***** Auswertung Diepold Wanderpokal
		Query = &quot;SELECT * FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Diepold_WP&quot;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;Jugend&quot;&quot; = FALSE ORDER BY &quot;&quot;Teiler&quot;&quot; ASC&quot;
		ResultSet = Statement.executeQuery(Query)
	
		ResultSet.last()
		iZaehler = ResultSet.getrow()
	
		If iZaehler &gt; 0 Then
	
			ReDim mSchuetze(iZaehler - 1)
	
			For i = 1 to iZaehler
		
				REM ***** Speichere Schuetzen in Array
				ResultSet.absolute(i)
		
				mSchuetze(i-1) = ResultSet.getInt(3)
	
			Next i
	
			For i = 1 to iZaehler
		
				REM ***** Schreibe Platzierung für Diepold Wanderpokal
				Query = &quot;UPDATE &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Diepold_WP&quot;&quot; SET &quot;&quot;Platz&quot;&quot; = &quot;&amp; i &amp;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i-1) &amp;&quot;&quot;
				Statement.executeUpdate(Query)
	
			Next i
		End If
	End If

	REM ***** Suche alle aktiven Jugendschützen
	Query = &quot;SELECT &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;SchuetzenID&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;, &quot;&quot;Schuetzenklassen&quot;&quot;, &quot;&quot;Schuetzen&quot;&quot; WHERE &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;Klasse&quot;&quot; = &quot;&quot;Schuetzenklassen&quot;&quot;.&quot;&quot;Klasse&quot;&quot; AND &quot;&quot;Schuetzenklassen&quot;&quot;.&quot;&quot;Jugendklasse&quot;&quot; = TRUE AND &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;SchuetzenID&quot;&quot; = &quot;&quot;Schuetzen&quot;&quot;.&quot;&quot;SchuetzenID&quot;&quot; AND &quot;&quot;Schuetzen&quot;&quot;.&quot;&quot;Aktiv&quot;&quot; = TRUE&quot;	
	ResultSet = Statement.executeQuery(Query)

	ResultSet.last()
	nZaehler = ResultSet.getrow()

	If nZaehler &gt; 0 Then
	
		ReDim mSchuetze(nZaehler - 1,2)

		For n = 1 to nZaehler
	
			REM ***** Speichere Schuetzen in Array
			ResultSet.absolute(n)
	
			mSchuetze(n-1,0) = ResultSet.getInt(1)

		Next n

		For n = 0 to nZaehler - 1

			REM ***** Suche alle Pokalteiler des Schuetzen in der aktuellen Saision 
			Query = &quot;SELECT &quot;&quot;Pokal&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Ergebnisse_Schiesstag&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(n,0) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;Pokal&quot;&quot; IS NOT NULL AND &quot;&quot;Pokal&quot;&quot; &lt; 999.9 ORDER BY &quot;&quot;Pokal&quot;&quot; ASC&quot;	
			ResultSet = Statement.executeQuery(Query)

			ResultSet.last()
			rZaehler = ResultSet.getrow()

			If rZaehler &gt; 0 Then

				ResultSet.absolute(1)

				REM ***** Speichere niedrigsten Teiler in Array
				mSchuetze(n,1) = ResultSet.getDouble(1)
			
			Else
				
				REM ***** Keinen Teiler gefunden
				mSchuetze(n,1) = 999.9

			End If

			REM ***** Suche alle Teiler 2. Programm des Schuetzen in der aktuellen Saision 
			Query = &quot;SELECT &quot;&quot;Programm_2&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Ergebnisse_Schiesstag&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(n,0) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;Programm_2&quot;&quot; IS NOT NULL AND &quot;&quot;Programm_2&quot;&quot; &lt; 999.9 ORDER BY &quot;&quot;Programm_2&quot;&quot; ASC&quot;	
			ResultSet = Statement.executeQuery(Query)

			ResultSet.last()
			rZaehler = ResultSet.getrow()

			If  rZaehler &gt; 0 Then

				ResultSet.absolute(1)

				REM ***** Speichere niedrigsten Teiler in Array
				mSchuetze(n,2) = ResultSet.getDouble(1)

			Else
				
				REM ***** Keinen Teiler gefunden
				mSchuetze(n,2) = 999.9

			End If

			If CDbl(mSchuetze(n,1)) &lt; 999.9 OR CDbl(mSchuetze(n,2)) &lt; 999.9 Then

				REM ***** Pokalteiler &lt;= Teiler 2. Programm?
				If CDbl(mSchuetze(n,1)) &lt; CDbl(mSchuetze(n,2)) Then
	
					REM ***** Schreibe Pokalteiler in Tabelle LG_Diepold_WP
					Query = &quot;INSERT INTO &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Diepold_WP&quot;&quot; (&quot;&quot;Saison&quot;&quot;, &quot;&quot;SchuetzenID&quot;&quot;,&quot;&quot;Teiler&quot;&quot;, &quot;&quot;Jugend&quot;&quot;, &quot;&quot;Klasse&quot;&quot;) VALUES (&quot;&amp; gSaison &amp;&quot;, &quot;&amp; mSchuetze(n,0) &amp;&quot;, &apos;&quot;&amp; Str(mSchuetze(n,1)) &amp;&quot;&apos;, TRUE, &apos;&quot;&amp; Klassen_Jugend &amp;&quot;&apos;)&quot; 
					Statement.executeUpdate(Query)
	
				Else
	
					REM ***** Schreibe Teiler 2. Programm in Tabelle LG_Diepold_WP
					Query = &quot;INSERT INTO &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Diepold_WP&quot;&quot; (&quot;&quot;Saison&quot;&quot;, &quot;&quot;SchuetzenID&quot;&quot;,&quot;&quot;Teiler&quot;&quot;, &quot;&quot;Jugend&quot;&quot;, &quot;&quot;Klasse&quot;&quot;) VALUES (&quot;&amp; gSaison &amp;&quot;, &quot;&amp; mSchuetze(n,0) &amp;&quot;, &apos;&quot;&amp; Str(mSchuetze(n,2)) &amp;&quot;&apos;, TRUE, &apos;&quot;&amp; Klassen_Jugend &amp;&quot;&apos;)&quot; 
					Statement.executeUpdate(Query)
	
				End If
			End If
		Next n

		REM ***** Auswertung Diepold Wanderpokal
		Query = &quot;SELECT * FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Diepold_WP&quot;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;Jugend&quot;&quot; = TRUE ORDER BY &quot;&quot;Teiler&quot;&quot; ASC&quot;
		ResultSet = Statement.executeQuery(Query)
	
		ResultSet.last()
		iZaehler = ResultSet.getrow()
	
		If iZaehler &gt; 0 Then
	
			ReDim mSchuetze(iZaehler - 1)
	
			For i = 1 to iZaehler
		
				REM ***** Speichere Schuetzen in Array
				ResultSet.absolute(i)
		
				mSchuetze(i-1) = ResultSet.getInt(3)
	
			Next i
	
			For i = 1 to iZaehler
		
				REM ***** Schreibe Platzierung für Diepold Wanderpokal
				Query = &quot;UPDATE &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Diepold_WP&quot;&quot; SET &quot;&quot;Platz&quot;&quot; = &quot;&amp; i &amp;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i-1) &amp;&quot;&quot;
				Statement.executeUpdate(Query)
	
			Next i

		End If

	End If

	REM ***** Bericht öffnen
	ReportDoc = DataSource.DatabaseDocument.ReportDocuments.loadComponentFromURL(sTyp &amp;&quot;_Diepold_WP&quot;,&quot;_blank&quot;, 0, Args())
	
	REM ***** Bericht drucken *****
&apos;	ReportDoc.print(ArgsPrint())

	REM ***** Bericht als PDF speichern *****
	Call SaveAsPDF_LG_Diepold_WP(ReportDoc)

	REM ***** Bericht schließen *****
	ReportDoc.close(true)

End Sub

REM ***** Auswertung Theo Roehrner Wanderpokal
Sub Auswertung_Roehrner_WP(ByVal sTyp As String)

	Dim nSaison_Vorjahr As Integer
	Dim Tage As Integer
	Dim mSchuetze() As String
	Dim iZaehler, nZaehler, rZaehler, zZaehler As Integer
	Dim i, n, r, z As Integer
	Dim Teiler, Erg As Double
	Dim Document As Object
	Dim ReportDoc As Object
	Dim Args(1) As New com.sun.star.beans.PropertyValue			&apos;Array zum Öffnen von Formularen/Berichten
	Dim ArgsPrint(1) As New com.sun.star.beans.PropertyValue   	&apos;Array zum Drucken von Berichten
	
	REM ***** Initialisierung des Arrays zum Öffnen von Formularen/Berichten
	Args(0).Name = &quot;ActiveConnection&quot;
	Args(0).Value = Connection
	Args(1).Name = &quot;OpenMode&quot;
	Args(1).Value = &quot;open&quot;

	REM ***** Initialisierung des Druckers
&apos;	Document = ThisComponent
&apos;	Prop = Document.getPrinter()

	REM ***** Initialisierung des Arrays zum Drucken von Berichten
&apos;	ArgsPrint(0).name = &quot;Name&quot;               
&apos;	ArgsPrint(0).value = &quot;&lt;&quot; &amp; Prop(0).value &amp; &quot;&gt;&quot;      
&apos;	ArgsPrint(1).name = &quot;Wait&quot;               
&apos;	ArgsPrint(1).value = True                  

	REM ***** Ermittle die Saison des Vorjahres *****
	Query = &quot;SELECT MAX(&quot;&quot;Saison&quot;&quot;) FROM &quot;&quot;Saison&quot;&quot; AS &quot;&quot;Saison&quot;&quot; GROUP BY &quot;&quot;Aktiv&quot;&quot; HAVING (&quot;&quot;Aktiv&quot;&quot; = FALSE)&quot;
	ResultSet = Statement.executeQuery(Query)

	ResultSet.last()

	REM ***** Überprüfe, ob ein Ergebnis geliefert wurde *****
	If ResultSet.getrow() &gt; 0 Then
	
		nSaison_Vorjahr = ResultSet.getInt(1)
		
	End If

	REM ***** Suche alle Schuetzen 
	Query = &quot;SELECT &quot;&quot;SchuetzenID&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;, &quot;&quot;Schuetzen&quot;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;SchuetzenID&quot;&quot; = &quot;&quot;Schuetzen&quot;&quot;.&quot;&quot;SchuetzenID&quot;&quot; AND &quot;&quot;Schuetzen&quot;&quot;.&quot;&quot;Aktiv&quot;&quot; = TRUE&quot;	
	ResultSet = Statement.executeQuery(Query)

	ResultSet.last()
	nZaehler = ResultSet.getrow()

	If nZaehler &gt; 0 Then
	
		ReDim mSchuetze(nZaehler - 1,2)

		For n = 1 to nZaehler
	
			REM ***** Speichere Schuetzen in Array
			ResultSet.absolute(n)
	
			mSchuetze(n-1,0) = ResultSet.getInt(1)

		Next n

		For n = 0 to nZaehler - 1

			REM ***** Lese Geburtsdatum des Schuetzen aus 
			Query = &quot;SELECT &quot;&quot;Geburtsdatum&quot;&quot; FROM &quot;&quot;Schuetzen&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(n,0) &amp;&quot;&quot;	
			ResultSet = Statement.executeQuery(Query)

			ResultSet.last()

			REM ***** Geburtsdatum speichern *****
			mSchuetze(n,2) = ResultSet.getString(1)
			

			REM ***** Zähle Anwesenheiten des Schuetzen in der letzen Saision 
			Query = &quot;SELECT COUNT(*) FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Ergebnisse_Schiesstag&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(n,0) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; nSaison_Vorjahr &amp;&quot;&quot;	
			ResultSet = Statement.executeQuery(Query)
			
			ResultSet.last()

			Tage = ResultSet.getInt(1)

			REM ***** Zähle Anwesenheiten des Schuetzen in der aktuellen Saision 
			Query = &quot;SELECT COUNT(*) FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Ergebnisse_Schiesstag&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(n,0) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;	
			ResultSet = Statement.executeQuery(Query)

			ResultSet.last()

			Tage = Tage + ResultSet.getInt(1)

			REM ***** Speichere Tage in Array
			mSchuetze(n,1) = Tage

			REM ***** Schreibe Daten in Tabelle LG_Roehrner_WP
			Query = &quot;INSERT INTO &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Roehrner_WP&quot;&quot; (&quot;&quot;Saison&quot;&quot;, &quot;&quot;SchuetzenID&quot;&quot;,&quot;&quot;Tage&quot;&quot;, &quot;&quot;Geburtsdatum&quot;&quot;) VALUES (&quot;&amp; gSaison &amp;&quot;, &quot;&amp; mSchuetze(n,0) &amp;&quot;, &quot;&amp; mSchuetze(n,1) &amp;&quot;, {D &apos;&quot;&amp; mSchuetze(n,2) &amp;&quot;&apos;})&quot; 
			Statement.executeUpdate(Query)

		Next n

		REM ***** Auswertung Theo Roehrner Wanderpokal
		Query = &quot;SELECT * FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Roehrner_WP&quot;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; ORDER BY &quot;&quot;Tage&quot;&quot; DESC, &quot;&quot;Geburtsdatum&quot;&quot; ASC&quot;
		ResultSet = Statement.executeQuery(Query)
	
		ResultSet.last()
		iZaehler = ResultSet.getrow()
	
		If iZaehler &gt; 0 Then
	
			ReDim mSchuetze(iZaehler - 1)
	
			For i = 1 to iZaehler
		
				REM ***** Speichere Schuetzen in Array
				ResultSet.absolute(i)
		
				mSchuetze(i-1) = ResultSet.getInt(3)
	
			Next i
	
			For i = 1 to iZaehler
		
				REM ***** Schreibe Platzierung für Diepold Wanderpokal
				Query = &quot;UPDATE &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Roehrner_WP&quot;&quot; SET &quot;&quot;Platz&quot;&quot; = &quot;&amp; i &amp;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i-1) &amp;&quot;&quot;
				Statement.executeUpdate(Query)
	
			Next i

		End If

	End If	

	REM ***** Bericht öffnen
	ReportDoc = DataSource.DatabaseDocument.ReportDocuments.loadComponentFromURL(sTyp &amp;&quot;_Roehrner_WP&quot;,&quot;_blank&quot;, 0, Args())
	
	REM ***** Bericht drucken *****
&apos;	ReportDoc.print(ArgsPrint())

	REM ***** Bericht als PDF speichern *****
	Call SaveAsPDF_LG_Roehrner_WP(ReportDoc)

	REM ***** Bericht schließen *****
	ReportDoc.close(true)

End Sub
</script:module>