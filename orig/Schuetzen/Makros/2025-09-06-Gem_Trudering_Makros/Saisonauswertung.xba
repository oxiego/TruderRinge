<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE script:module PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "module.dtd">
<script:module xmlns:script="http://openoffice.org/2000/script" script:name="Saisonauswertung" script:language="StarBasic">REM ***** Variablen für den Dialog *****
Private oPBSAListener1
Private oPBSAListener2
Private oSADialog As Object

Private sTyp As String				&apos;Private Variable für den Typ (LG/LP)

Sub LG_LP_Saisonauswertung

	REM ***** Überprüfe ob eine laufende Saison vorhanden ist *****
	REM ***** Wenn Saison &gt; 0, dann laufende Saison vorhanden *****
	If gSaison = 0 Then

		MsgBox &quot;Keine Saison zum Auswerten gefunden!&quot;, 16, &quot;Fehler&quot;

		Exit Sub
		
	End If

	Rem ***** Prüfen ob alle Schiesstage vorhanden sind
	If PruefungDaten(&quot;LG&quot;) Then
	
		REM ***** Dialog für Auswahlmenü aufrufen
		sTyp = &quot;LG&quot;
		Call DialogAuswahl()
	
		REM ***** Überprüfe, ob in laufender Saison jemand Luftpistole geschossen hat *****
		Query = &quot;SELECT COUNT(&quot;&quot;SchuetzenID&quot;&quot;) FROM &quot;&quot;LP_Ergebnisse_Schiesstag&quot;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &apos;&quot;&amp; gSaison &amp;&quot;&apos;&quot;
		ResultSet = Statement.executeQuery(Query)
	
		ResultSet.last()
	
		If ResultSet.getInt(1) &gt; 0 Then
	
			sTyp = &quot;LP&quot;
			Call DialogAuswahl()
		
		End If

	End If

	MsgBox &quot;Saisonauswertung abgeschlossen!&quot;, 64, &quot;Hinweis&quot;

End Sub

REM ***** PrüfeDaten Daten auf Vollständigkeit *****
Function PruefungDaten(ByVal sTyp As String) As Boolean

	Dim i As Integer

	PruefungDaten = TRUE

	REM ***** Zähle Anzahl Schiesstage *****
	Query = &quot;SELECT COUNT(&quot;&quot;Schiesstag&quot;&quot;) FROM &quot;&quot;Schiesstage&quot;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &apos;&quot;&amp; gSaison &amp;&quot;&apos;&quot;
	ResultSet = Statement.executeQuery(Query)

	ResultSet.last()

	If ResultSet.getInt(1) = gSchiesstag Then

		For i = 1 to gSchiesstag
		
			Query = &quot;SELECT COUNT(*) FROM &quot;&quot;LG_Ergebnisse_Schiesstag&quot;&quot; WHERE &quot;&quot;Schiesstag&quot;&quot; = &apos;&quot;&amp; i &amp;&quot;&apos; AND &quot;&quot;Saison&quot;&quot; = &apos;&quot;&amp; gSaison &amp;&quot;&apos;&quot;
			ResultSet = Statement.executeQuery(Query)
		
			ResultSet.last()
			
			If ResultSet.getInt(1) = 0 Then

				PruefungDaten = FALSE
				MsgBox &quot;Fehler bei Datenprüfung!/n Kein LG Ergebnisse für Schiesstag &quot;&amp; i &amp;&quot; gefunden!&quot;, 16, &quot;Fehler&quot;
				Break

			End If

		Next i

	End If
		
End Function

REM ***** Dialog für Auswahlmenü *****
Sub DialogAuswahl()

	Dim oDialogModel As Object
	Dim oWindow As Object
	Dim oMod As Object
	Dim oEvent1
	Dim oEvent2
	Dim nEintrag As Integer

	REM ***** Berechnung der Dialoggröße *****
	If sTyp = &quot;LG&quot; Then
	
		nEintrag = 8
	
	Else
	
		nEintrag = 8
		
	End If

	REM ***** Initialisierung der Eigenschaften des Dialogs *****
	oDialogModel = CreateUnoService(&quot;com.sun.star.awt.UnoControlDialogModel&quot;)
	With oDialogModel
		.setPropertyValue(&quot;PositionX&quot;, 270)
		.setPropertyValue(&quot;PositionY&quot;, 150 )
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Width&quot;, Fontsize * 17)
		.setPropertyValue(&quot;Height&quot;, (Fontsize * 3) + (nEintrag * (Fontsize + 7)))
		.setPropertyValue(&quot;Title&quot;, sTyp +&quot; Saisonauswertung&quot;)
	End With
	
	oSADialog = CreateUnoService(&quot;com.sun.star.awt.UnoControlDialog&quot;)
	
	REM ***** Textlabel erzeugen
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
	With oMod
		.setPropertyValue(&quot;Label&quot;, &quot;Auswertung &quot; + sTyp + &quot; für Schießjahr &quot; + gSaison)
		.setPropertyValue(&quot;Name&quot;, &quot;Beschreibung&quot;)
		.setPropertyValue(&quot;PositionX&quot;, 0)
		.setPropertyValue(&quot;PositionY&quot;, Fontsize)
		.setPropertyValue(&quot;Align&quot;, 1)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;FontUnderline&quot;, 1)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
		.setPropertyValue(&quot;Width&quot;, oDialogModel.Width)
	End With

	oDialogModel.insertByName(&quot;Beschreibung&quot;, oMod)

	REM ***** Textlabel erzeugen
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
	With oMod
		.setPropertyValue(&quot;Label&quot;, &quot;Königsschiessen :&quot;)
		.setPropertyValue(&quot;Name&quot;, &quot;Koenig&quot;)
		.setPropertyValue(&quot;PositionX&quot;, 25)
		.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3))
		.setPropertyValue(&quot;Align&quot;, 0)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
		.setPropertyValue(&quot;Width&quot;, 100)
	End With

	oDialogModel.insertByName(&quot;Koenig&quot;, oMod)

	REM ***** Checkboxen erzeugen
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlCheckBoxModel&quot;)
	With oMod
		.setPropertyValue(&quot;Name&quot;, &quot;CB_Koenig&quot;)
		.setPropertyValue(&quot;PositionX&quot;, 130)
		.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + 1)
		.setPropertyValue(&quot;Align&quot;, 0)
		.setPropertyValue(&quot;VerticalAlign&quot;, 0)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
		.setPropertyValue(&quot;Width&quot;, 55)
		.setPropertyValue(&quot;State&quot;, 1)

	End With
			
	oDialogModel.insertByName(&quot;CB_Koenig&quot;, oMod)

	REM ***** Textlabel erzeugen
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
	With oMod
		.setPropertyValue(&quot;Label&quot;, &quot;Vereinsmeister :&quot;)
		.setPropertyValue(&quot;Name&quot;, &quot;Verein&quot;)
		.setPropertyValue(&quot;PositionX&quot;, 25)
		.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + (1 * (Fontsize + 5)))
		.setPropertyValue(&quot;Align&quot;, 0)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
		.setPropertyValue(&quot;Width&quot;, 100)
	End With

	oDialogModel.insertByName(&quot;Verein&quot;, oMod)

	REM ***** Checkboxen erzeugen
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlCheckBoxModel&quot;)
	With oMod
		.setPropertyValue(&quot;Name&quot;, &quot;CB_Verein&quot;)
		.setPropertyValue(&quot;PositionX&quot;, 130)
		.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + (1 * (Fontsize + 5)) + 1)
		.setPropertyValue(&quot;Align&quot;, 0)
		.setPropertyValue(&quot;VerticalAlign&quot;, 0)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
		.setPropertyValue(&quot;Width&quot;, 55)
		.setPropertyValue(&quot;State&quot;, 1)

	End With
			
	oDialogModel.insertByName(&quot;CB_Verein&quot;, oMod)

	REM ***** Textlabel erzeugen
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
	With oMod
		.setPropertyValue(&quot;Label&quot;, &quot;Geldpreise :&quot;)
		.setPropertyValue(&quot;Name&quot;, &quot;Geld&quot;)
		.setPropertyValue(&quot;PositionX&quot;, 25)
		.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + (2 * (Fontsize + 5)))
		.setPropertyValue(&quot;Align&quot;, 0)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
		.setPropertyValue(&quot;Width&quot;, 100)
	End With

	oDialogModel.insertByName(&quot;Geld&quot;, oMod)

	REM ***** Checkboxen erzeugen
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlCheckBoxModel&quot;)
	With oMod
		.setPropertyValue(&quot;Name&quot;, &quot;CB_Geld&quot;)
		.setPropertyValue(&quot;PositionX&quot;, 130)
		.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + (2 * (Fontsize + 5)) + 1)
		.setPropertyValue(&quot;Align&quot;, 0)
		.setPropertyValue(&quot;VerticalAlign&quot;, 0)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
		.setPropertyValue(&quot;Width&quot;, 55)
		.setPropertyValue(&quot;State&quot;, 1)

	End With
			
	oDialogModel.insertByName(&quot;CB_Geld&quot;, oMod)

	REM ***** Textlabel erzeugen
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
	With oMod
		.setPropertyValue(&quot;Label&quot;, &quot;Pokalteiler :&quot;)
		.setPropertyValue(&quot;Name&quot;, &quot;Pokal&quot;)
		.setPropertyValue(&quot;PositionX&quot;, 25)
		.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + (3 * (Fontsize + 5)))
		.setPropertyValue(&quot;Align&quot;, 0)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
		.setPropertyValue(&quot;Width&quot;, 100)
	End With

	oDialogModel.insertByName(&quot;Pokal&quot;, oMod)

	REM ***** Checkboxen erzeugen
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlCheckBoxModel&quot;)
	With oMod
		.setPropertyValue(&quot;Name&quot;, &quot;CB_Pokal&quot;)
		.setPropertyValue(&quot;PositionX&quot;, 130)
		.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + (3 * (Fontsize + 5)) + 1)
		.setPropertyValue(&quot;Align&quot;, 0)
		.setPropertyValue(&quot;VerticalAlign&quot;, 0)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
		.setPropertyValue(&quot;Width&quot;, 55)
		.setPropertyValue(&quot;State&quot;, 1)

	End With
			
	oDialogModel.insertByName(&quot;CB_Pokal&quot;, oMod)

	REM ***** Textlabel erzeugen
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
	With oMod
		.setPropertyValue(&quot;Label&quot;, &quot;Schmankerlpokal :&quot;)
		.setPropertyValue(&quot;Name&quot;, &quot;Schmankerl&quot;)
		.setPropertyValue(&quot;PositionX&quot;, 25)
		.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + (4 * (Fontsize + 5)))
		.setPropertyValue(&quot;Align&quot;, 0)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
		.setPropertyValue(&quot;Width&quot;, 100)
	End With

	oDialogModel.insertByName(&quot;Schmankerl&quot;, oMod)

	REM ***** Checkboxen erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlCheckBoxModel&quot;)
	With oMod
		.setPropertyValue(&quot;Name&quot;, &quot;CB_Schmankerl&quot;)
		.setPropertyValue(&quot;PositionX&quot;, 130)
		.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + (4 * (Fontsize + 5)) + 1)
		.setPropertyValue(&quot;Align&quot;, 0)
		.setPropertyValue(&quot;VerticalAlign&quot;, 0)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
		.setPropertyValue(&quot;Width&quot;, 55)
		.setPropertyValue(&quot;State&quot;, 1)

	End With
			
	oDialogModel.insertByName(&quot;CB_Schmankerl&quot;, oMod)
	
	If sTyp = &quot;LG&quot; Then
	
		REM ***** Textlabel erzeugen
		oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
		With oMod
			.setPropertyValue(&quot;Label&quot;, &quot;Diepold-Wanderpokal :&quot;)
			.setPropertyValue(&quot;Name&quot;, &quot;Diepold&quot;)
			.setPropertyValue(&quot;PositionX&quot;, 25)
			.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + (5 * (Fontsize + 5)))
			.setPropertyValue(&quot;Align&quot;, 0)
			.setPropertyValue(&quot;FontName&quot;, Font)
			.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
			.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
			.setPropertyValue(&quot;Width&quot;, 100)
		End With
	
		oDialogModel.insertByName(&quot;Diepold&quot;, oMod)
	
		REM ***** Checkboxen erzeugen
		oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlCheckBoxModel&quot;)
		With oMod
			.setPropertyValue(&quot;Name&quot;, &quot;CB_Diepold&quot;)
			.setPropertyValue(&quot;PositionX&quot;, 130)
			.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + (5 * (Fontsize + 5)) + 1)
			.setPropertyValue(&quot;Align&quot;, 0)
			.setPropertyValue(&quot;VerticalAlign&quot;, 0)
			.setPropertyValue(&quot;FontName&quot;, Font)
			.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
			.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
			.setPropertyValue(&quot;Width&quot;, 55)
			.setPropertyValue(&quot;State&quot;, 1)
	
		End With
				
		oDialogModel.insertByName(&quot;CB_Diepold&quot;, oMod)
	
		REM ***** Textlabel erzeugen *****
		oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
		With oMod
			.setPropertyValue(&quot;Label&quot;, &quot;Theo Röhrner Wanderpokal :&quot;)
			.setPropertyValue(&quot;Name&quot;, &quot;Roehrner&quot;)
			.setPropertyValue(&quot;PositionX&quot;, 25)
			.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + (6 * (Fontsize + 5)))
			.setPropertyValue(&quot;Align&quot;, 0)
			.setPropertyValue(&quot;FontName&quot;, Font)
			.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
			.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
			.setPropertyValue(&quot;Width&quot;, 100)
		End With
	
		oDialogModel.insertByName(&quot;Roehrner&quot;, oMod)
	
		REM ***** Checkboxen erzeugen *****
		oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlCheckBoxModel&quot;)
		With oMod
			.setPropertyValue(&quot;Name&quot;, &quot;CB_Roehrner&quot;)
			.setPropertyValue(&quot;PositionX&quot;, 130)
			.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + (6 * (Fontsize + 5)) + 1)
			.setPropertyValue(&quot;Align&quot;, 0)
			.setPropertyValue(&quot;VerticalAlign&quot;, 0)
			.setPropertyValue(&quot;FontName&quot;, Font)
			.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
			.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
			.setPropertyValue(&quot;Width&quot;, 55)
			.setPropertyValue(&quot;State&quot;, 0)
	
		End With
				
		oDialogModel.insertByName(&quot;CB_Roehrner&quot;, oMod)

	End If
	
	REM ***** Pushbutton erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlButtonModel&quot;)
	With oMod
		.setPropertyValue(&quot;Label&quot;, &quot;Weiter&quot;)
		.setPropertyValue(&quot;Name&quot;, &quot;PB1&quot;)
		.setPropertyValue(&quot;PositionX&quot;, INT(oDialogModel.Width / 2 - (2 * Fontsize + 22)))
		.setPropertyValue(&quot;PositionY&quot;, oDialogModel.Height - (2 * Fontsize + 2))
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 7)
		.setPropertyValue(&quot;Width&quot;, 2 * Fontsize + 20)
	End With
	
	oDialogModel.insertByName(&quot;PB1&quot;, oMod)
	
	REM ***** Pushbutton erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlButtonModel&quot;)
	With oMod
		.setPropertyValue(&quot;Label&quot;, &quot;Abbruch&quot;)
		.setPropertyValue(&quot;Name&quot;, &quot;PB2&quot;)
		.setPropertyValue(&quot;PositionX&quot;, INT(oDialogModel.Width /2) + 2)
		.setPropertyValue(&quot;PositionY&quot;, oDialogModel.Height - (2 * Fontsize + 2))
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 7)
		.setPropertyValue(&quot;Width&quot;, 2 * Fontsize + 20)
	End With
	
	oDialogModel.insertByName(&quot;PB2&quot;, oMod)
	
	oSADialog.setModel(oDialogModel)
	
	REM ***** Listener für den Weiter-Button *****
	oPBSAListener1 = createUnoListener(&quot;PB1_SA_&quot;, &quot;com.sun.star.awt.XActionListener&quot;)
	oControl = oSADialog.getControl(&quot;PB1&quot;)
	oControl.addActionListener(oPBSAListener1)
	
	REM ***** Listener für den Abbruch-Button *****
	oPBSAListener2 = createUnoListener(&quot;PB2_SA_&quot;, &quot;com.sun.star.awt.XActionListener&quot;)
	oControl = oSADialog.getControl(&quot;PB2&quot;)
	oControl.addActionListener(oPBSAListener2)
	
	REM ***** Mittels des Modells den Dialog anzeigen *****
	oWindow = CreateUnoService(&quot;com.sun.star.awt.Toolkit&quot;)
	oSADialog.createPeer(oWindow, null)
	oSADialog.execute()

End Sub

REM ***** Die Aktion des Listeners für den Weiter-Button *****
Sub PB1_SA_actionPerformed(oEvent1)

	Dim oDialogField As Object
	Dim cbState As Boolean
	
	REM *****Entfernen der Listener *****
	oSADialog.getControl(&quot;PB1&quot;).removeActionListener(oPBSAListener1)
	oSADialog.getControl(&quot;PB2&quot;).removeActionListener(oPBSAListener2)
	
	REM *****Schliessen des Dialogs *****
	oSADialog.EndExecute()

	REM ***** CheckField-Status im Dialog ansprechen *****
	oDialogField = oSADialog.getControl(&quot;CB_Koenig&quot;)
	
	REM ***** CheckField-Status im Dialog auslesen *****
	cbState = oDialogField.State
	
	If cbState Then

		REM ***** Rufe Auswertung Koenig auf *****
		Call Auswertung_Koenig(sTyp)

 	End If

	REM ***** CheckField-Status im Dialog ansprechen *****
	oDialogField = oSADialog.getControl(&quot;CB_Verein&quot;)
	
	REM ***** CheckField-Status im Dialog auslesen *****
	cbState = oDialogField.State
	
	If cbState Then

		REM ***** TABELLEN LG_/LP_Vereinsmeister zurücksetzen *****
		Query = &quot;DELETE FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Vereinsmeister&quot;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;
		Statement.executeUpdate(Query)

		REM ***** Rufe Auswertung Vereinsmeister auf *****
		Call Auswertung_Vereinsmeister(sTyp)

 	End If

	REM ***** CheckField-Status im Dialog ansprechen *****
	oDialogField = oSADialog.getControl(&quot;CB_Geld&quot;)
	
	REM ***** CheckField-Status im Dialog auslesen *****
	cbState = oDialogField.State
	
	If cbState Then

		REM ***** TABELLE LG_/LP_Geldpreise_Saison zurücksetzen *****
		Query = &quot;DELETE FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Geldpreise_Saison&quot;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;
		Statement.executeUpdate(Query)

		REM ***** Rufe LG Auswertung Geldpreise auf *****
		Call Auswertung_Geldpreise(sTyp)

 	End If

	REM ***** CheckField-Status im Dialog ansprechen *****
	oDialogField = oSADialog.getControl(&quot;CB_Pokal&quot;)
	
	REM ***** CheckField-Status im Dialog auslesen
	cbState = oDialogField.State
	
	If cbState Then

		REM ***** TABELLE &quot;LG_Pokalteiler&quot; zurücksetzen *****
		Query = &quot;DELETE FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Pokalteiler&quot;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;
		Statement.executeUpdate(Query)

		REM ***** Rufe LG Auswertung Pokalteiler auf *****
		Call Auswertung_Pokalteiler(sTyp)

 	End If

	If sTyp = &quot;LG&quot; Then

		REM ***** CheckField-Status im Dialog ansprechen *****
		oDialogField = oSADialog.getControl(&quot;CB_Diepold&quot;)
		
		REM ***** CheckField-Status im Dialog auslesen *****
		cbState = oDialogField.State
		
		If cbState Then
	
			REM ***** TABELLE &quot;LG_Diepold_WP&quot; zurücksetzen *****
			Query = &quot;DELETE FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Diepold_WP&quot;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;
			Statement.executeUpdate(Query)
	
			REM ***** Rufe Auswertung Diepold Wanderpokal auf
			Call Auswertung_Diepold_WP(sTyp)
	
	 	End If

 	End If

	REM ***** CheckField-Status im Dialog ansprechen
	oDialogField = oSADialog.getControl(&quot;CB_Schmankerl&quot;)
	
	REM ***** CheckField-Status im Dialog auslesen
	cbState = oDialogField.State
	
	If cbState Then

		REM ***** Rufe Auswertung Schmankerlpokal auf
		Call Auswertung_Schmankerlpokal(sTyp)

 	End If

	If sTyp = &quot;LG&quot; Then

		REM ***** CheckField-Status im Dialog ansprechen
		oDialogField = oSADialog.getControl(&quot;CB_Roehrner&quot;)
		
		REM ***** CheckField-Status im Dialog auslesen
		cbState = oDialogField.State
		
		If cbState Then
	
			REM ***** TABELLE &quot;LG_Roehrner_WP&quot; zurücksetzen *****
			Query = &quot;DELETE FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Roehrner_WP&quot;&quot; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;
			Statement.executeUpdate(Query)
	
			REM ***** Rufe Auswertung Theo Roehrner Wanderpokal auf
			Call Auswertung_Roehrner_WP(sTyp)
	
	 	End If

 	End If

	REM *****  *****
	Query = &quot;UPDATE &quot;&quot;Saison&quot;&quot; SET &quot;&quot;Auswertung_&quot;&amp; sTyp &amp;&quot;&quot;&quot; = &apos;TRUE&apos; WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;Aktiv&quot;&quot; = &apos;TRUE&apos;&quot;
	Statement.executeUpdate(Query)

End Sub

