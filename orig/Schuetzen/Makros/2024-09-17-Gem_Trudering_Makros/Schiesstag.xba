<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE script:module PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "module.dtd">
<script:module xmlns:script="http://openoffice.org/2000/script" script:name="Schiesstag" script:language="StarBasic">REM ***** Makros zum Erzeugen eines neuen Schiesstages in der laufenden Saison*****

REM ***** Variablen für den Dialog *****
Private oPBSchiesstagListener1
Private oPBSchiesstagListener2
Private oSchiesstagDialog As Object

Private mKlasse() As Variant
Private nSchiesstag As Integer
Private bFleisch As Boolean

REM ***** Makro zur Anlegen eines neuen Schiesstages in der laufenden Saison *****
Sub Schiesstag_erzeugen

	Dim nAnzahl As Integer
	Dim iZaehler As Integer
	Dim i As Integer

	REM ***** Hole aktuelle Daten aus der Datenbank *****
	nSchiesstag = getSchiesstag(gSaison)
	bFleisch = getFleisch(nSchiesstag, gSaison)

	REM ***** Überprüfe ob eine laufende Saison vorhanden ist *****
	REM ***** Wenn Saison &gt; 0, dann laufende Saison vorhanden *****
	If gSaison = 0 Then

		MsgBox &quot;Keine laufende Saison gefunden!&quot;, 16, &quot;Fehler&quot;

		REM ***** Beende Makro, wenn keine Saison gefunden wurde *****
		Exit Sub

	End If

	REM ***** Lies Datum des aktuellen Schiesstages aus *****
	Query = &quot;SELECT &quot;&quot;Datum&quot;&quot; FROM &quot;&quot;Schiesstage&quot;&quot; WHERE &quot;&quot;Schiesstag&quot;&quot; = &quot;&amp; gSchiesstag &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; &quot;
	ResultSet = Statement.executeQuery(Query)

	ResultSet.last()

	REM ***** Überprüfe, ob ein Ergebnis geliefert wurde *****
	If ResultSet.getrow() &gt; 0 Then

		REM ***** Überprüfe ob Datum Schiesstage != Tagesdatum *****
		If ResultSet.getString(1) = sDatum Then

			MsgBox &quot;Es wurde bereits ein Schiesstag begonnen!&quot;, 16, &quot;Fehler&quot;

			REM ***** Beende Makro, wenn für das heutige Datum bereits ein Schiesstag begonnen wurde *****
			Exit Sub

		End If

	End If

	Rem ***** Wurde am letzten Schiesstag Fleisch geschossen? *****
	If bFleisch = FALSE Then

		REM ***** Setze Fleisch für den aktuellen Schiesstag *****
		bFleisch = TRUE

	Else

		bFleisch = FALSE
	
	End If

	nAnzahl = 0

	REM ***** Überprüfe die Anzahl der Fleischpreise pro Schützenklasse *****
	Query = &quot;SELECT * FROM &quot;&quot;Fleischpreise_Anzahl&quot;&quot; ORDER BY &quot;&quot;Klasse&quot;&quot; ASC&quot;
	ResultSet = Statement.executeQuery(Query)

	ResultSet.last()

	REM ***** Überprüfe, ob ein Ergebnis geliefert wurde *****
	If ResultSet.getrow() &gt; 0 Then

		iZaehler = ResultSet.getrow()

		REM ***** Initialisiere Variablen *****
		ReDim mKlasse(iZaehler - 1,1)

		For i = 0 to iZaehler - 1
	
			ResultSet.absolute(i + 1)
	
			REM ***** Speichere Schuetzenklassen in Array *****
			mKlasse(i,0) = ResultSet.getString(1)
			mKlasse(i,1) = ResultSet.getInt(2)

			REM ***** Wenn Fleisch geschossen wird, zähle Anzahl Klassen mit Fleisch *****
			If bFleisch And mKlasse(i,1) &gt; 0 Then

				nAnzahl = nAnzahl + 1

			End If

		Next i

	End If

	REM ***** Es gibt keine Klassen mehr die Fleisch schiessen *****
	If bFleisch AND nAnzahl = 0 Then
		bFleisch = FALSE
	End If
	
	REM ***** Initialsisiere Variable *****
	nSchiesstag = nSchiesstag + 1

	REM ***** Dialog aufrufen *****
	Call Dialog_Schiesstag()
	
	REM ***** Speichere Daten auf Disk *****
	&apos;DataSource.flush

End Sub

REM ***** Dialog für neuen Schiesstag *****
Sub Dialog_Schiesstag

	Dim oDialogModel As Object
	Dim oWindow As Object
	Dim oMod As Object
	Dim oEvent1
	Dim oEvent2
	Dim i As Integer
	
	REM ***** Initialisierung der Eigenschaften des Dialogs
	oDialogModel = CreateUnoService(&quot;com.sun.star.awt.UnoControlDialogModel&quot;)
	With oDialogModel
		.setPropertyValue(&quot;PositionX&quot;, 270)
		.setPropertyValue(&quot;PositionY&quot;, 150 )
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Width&quot;, 150)
		.setPropertyValue(&quot;Height&quot;, (Fontsize + 23) * (UBOUND(mKlasse())+ 1))
		.setPropertyValue(&quot;Title&quot;, &quot;Neuen Schiesstag beginnen&quot;)
	End With
	
	oSchiesstagDialog = CreateUnoService(&quot;com.sun.star.awt.UnoControlDialog&quot;)
	
	REM ***** Textlabel erzeugen
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
	With oMod
		.setPropertyValue(&quot;Label&quot;, &quot;Schiesstag: &quot; &amp; nSchiesstag)
		.setPropertyValue(&quot;Name&quot;, &quot;LabelSD&quot;)
		.setPropertyValue(&quot;PositionX&quot;, 10)
		.setPropertyValue(&quot;PositionY&quot;, Fontsize)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
		.setPropertyValue(&quot;Width&quot;, 80)
		.setPropertyValue(&quot;HelpText&quot;, &quot;Aktueller Schiesstag&quot;)
	End With
	
	oDialogModel.insertByName(&quot;LabelSD&quot;, oMod)
	
	REM ***** Textlabel erzeugen
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
	With oMod
		.setPropertyValue(&quot;Label&quot;, Format(Date, &quot;DD.MM.YYYY&quot;))
		.setPropertyValue(&quot;Name&quot;, &quot;LabelDate&quot;)
		.setPropertyValue(&quot;PositionX&quot;, 90)
		.setPropertyValue(&quot;PositionY&quot;, Fontsize)
		.setPropertyValue(&quot;Align&quot;, 2)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
		.setPropertyValue(&quot;Width&quot;, 50)
		.setPropertyValue(&quot;HelpText&quot;, &quot;Datum&quot;)
	End With
	
	oDialogModel.insertByName(&quot;LabelDate&quot;, oMod)
	
	REM ***** Linie erzeugen
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedLineModel&quot;)
	With oMod
		.setPropertyValue(&quot;Name&quot;, &quot;FixedLabel&quot;)
		.setPropertyValue(&quot;PositionX&quot;, 10)
		.setPropertyValue(&quot;PositionY&quot;, Fontsize * 2)
		.setPropertyValue(&quot;Height&quot;, 5)
		.setPropertyValue(&quot;Width&quot;, 130)
	End With
	
	oDialogModel.insertByName(&quot;FixedLabel&quot;, oMod)
	
	For i = 1 to UBOUND(mKlasse()) + 1
			
		REM ***** Textlabel erzeugen
		oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
		With oMod
			.setPropertyValue(&quot;Label&quot;, &quot;Klasse &quot; &amp; mKlasse(i-1,0) &amp; &quot;:&quot;)
			.setPropertyValue(&quot;Name&quot;, &quot;Label&quot; &amp; i + 1)
			.setPropertyValue(&quot;PositionX&quot;, 30)
			.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 2) + (i * (Fontsize + 5)))
			.setPropertyValue(&quot;Align&quot;, 2)
			.setPropertyValue(&quot;FontName&quot;, Font)
			.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
			.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
			.setPropertyValue(&quot;Width&quot;, 40)
		End With
	
		oDialogModel.insertByName(&quot;Label&quot; &amp; i, oMod)
		
		REM ***** Checkboxen erzeugen
		oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlCheckBoxModel&quot;)
		With oMod
			.setPropertyValue(&quot;Label&quot;, &quot;Fleisch (&quot;&amp; mKlasse(i-1,1) &amp;&quot;)&quot;)
			.setPropertyValue(&quot;Name&quot;, mKlasse(i-1,0))
			.setPropertyValue(&quot;PositionX&quot;, 75)
			.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 2) + (i * (Fontsize + 5)))
			.setPropertyValue(&quot;Align&quot;, 0)
			.setPropertyValue(&quot;VerticalAlign&quot;, 0)
			.setPropertyValue(&quot;FontName&quot;, Font)
			.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
			.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
			.setPropertyValue(&quot;Width&quot;, 55)
	
			&apos;REM ***** Initialisiere Checkboxen
			If bFleisch AND mKlasse(i-1,1) &gt; 0 Then
				.setPropertyValue(&quot;State&quot;, 1)
			Else
				.setPropertyValue(&quot;State&quot;, 0)
			End If
			
			If mKlasse(i-1,1) = 0 Then

				REM ***** Deaktiviere Checkbox wenn kein Fleischpreis mehr vorhanden ist *****
				.setPropertyValue(&quot;Enabled&quot;, False)

			Else
			
				REM ***** Aktiviere Checkbox wenn noch Fleischpreis vorhanden ist *****
				.setPropertyValue(&quot;Enabled&quot;, True)
			
			End If
		End With
				
		oDialogModel.insertByName(mKlasse(i-1,0), oMod)

	Next i
	
	REM ***** Pushbutton erzeugen
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlButtonModel&quot;)
	With oMod
		.setPropertyValue(&quot;Label&quot;, &quot;Weiter&quot;)
		.setPropertyValue(&quot;Name&quot;, &quot;PB1&quot;)
		.setPropertyValue(&quot;PositionX&quot;, 35)
		.setPropertyValue(&quot;PositionY&quot;, oDialogModel.Height - 30)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 7)
		.setPropertyValue(&quot;Width&quot;, 2 * Fontsize + 20)
	End With
	
	oDialogModel.insertByName(&quot;PB1&quot;, oMod)
	
	REM ***** Pushbutton erzeugen
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlButtonModel&quot;)
	With oMod
		.setPropertyValue(&quot;Label&quot;, &quot;Abbruch&quot;)
		.setPropertyValue(&quot;Name&quot;, &quot;PB2&quot;)
		.setPropertyValue(&quot;PositionX&quot;, 80)
		.setPropertyValue(&quot;PositionY&quot;, oDialogModel.Height - 30)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 7)
		.setPropertyValue(&quot;Width&quot;, 2 * Fontsize + 20)
	End With
	
	oDialogModel.insertByName(&quot;PB2&quot;, oMod)
	
	oSchiesstagDialog.setModel(oDialogModel)
	
	REM ***** Listener für den Weiter Button
	oPBSchiesstagListener1 = createUnoListener(&quot;PB1_Schiesstag_&quot;, &quot;com.sun.star.awt.XActionListener&quot;)
	oControl = oSchiesstagDialog.getControl(&quot;PB1&quot;)
	oControl.addActionListener(oPBSchiesstagListener1)
	
	REM ***** Listener für den Abbruch Button
	oPBSchiesstagListener2 = createUnoListener(&quot;PB2_Schiesstag_&quot;, &quot;com.sun.star.awt.XActionListener&quot;)
	oControl = oSchiesstagDialog.getControl(&quot;PB2&quot;)
	oControl.addActionListener(oPBSchiesstagListener2)
	
	REM ***** Mittels des Modells den Dialog anzeigen
	oWindow = CreateUnoService(&quot;com.sun.star.awt.Toolkit&quot;)
	oSchiesstagDialog.createPeer(oWindow, null)
	oSchiesstagDialog.execute()

End Sub

REM ***** Die Aktion des Listeners für den Weiter-Button *****
Sub PB1_Schiesstag_actionPerformed(oEvent1)

	Dim oDialogField As Object
	Dim cbState As Boolean
	Dim i As Integer
	Dim nAnzahl As Integer
	Dim nRest As Integer


	REM ***** Entfernen der Listener *****
	oSchiesstagDialog.getControl(&quot;PB1&quot;).removeActionListener(oPBSchiesstagListener1)
	oSchiesstagDialog.getControl(&quot;PB2&quot;).removeActionListener(oPBSchiesstagListener2)
	
	REM ***** Schliessen des Dialogs *****
	oSchiesstagDialog.EndExecute()

	nAnzahl = 0
	
	REM ***** Werte aus Dialogfeld auslesen *****
	For i = 0 to UBOUND(mKlasse())
	
		REM ***** CeckBox-Status im Dialog ansprechen *****
		oDialogField = oSchiesstagDialog.getControl(mKlasse(i,0))
	
		REM ***** CeckBox-Status im Dialog auslesen *****
		cbState= oDialogField.State
	
		REM ***** Daten in Tabelle &quot;Fleischpreise_Schiesstag&quot; schreiben *****
		Query = &quot;INSERT INTO &quot;&quot;Fleischpreise_Schiesstag&quot;&quot; (&quot;&quot;Schiesstag&quot;&quot;, &quot;&quot;Klasse&quot;&quot;, &quot;&quot;Fleisch&quot;&quot;) VALUES (&quot;&amp; nSchiesstag &amp;&quot;, &apos;&quot;&amp; mKlasse(i,0) &amp;&quot;&apos;, &apos;&quot;&amp; cbState &amp;&quot;&apos;)&quot;
		Statement.executeUpdate(Query)
	
		nRest = mKlasse(i,1)
	
		If cbState Then

			REM ***** Zähle Anzahl Klassen die Fleisch schiessen *****
			nAnzahl = nAnzahl + 1	

			REM ***** Anzahl der verbleibenden Fleischpreise reduzieren *****
			If nRest &gt; 0 Then
		
				nRest = nRest - 1
	
				REM ***** Schreibe neue Werte in die Tabelle &quot;Fleischpreise_Anzahl&quot; *****
				Query = &quot;UPDATE &quot;&quot;Fleischpreise_Anzahl&quot;&quot; SET &quot;&quot;Tage&quot;&quot; = &quot;&amp; nRest &amp;&quot; WHERE &quot;&quot;Klasse&quot;&quot; = &apos;&quot;&amp; mKlasse(i,0) &amp;&quot;&apos;&quot;
				Statement.executeUpdate(Query)

			End If

		End If

	Next i

	REM ***** Setzte Variable für Fleisch *****
	If nAnzahl &gt; 0 Then

		bFleisch = TRUE

	Else

		bFleisch = FALSE	

	End If
	
	REM ***** Aktuellen Schiesstag in Tabelle &quot;Schiesstage&quot; schreiben.
	Query = &quot;INSERT INTO &quot;&quot;Schiesstage&quot;&quot; (&quot;&quot;Saison&quot;&quot;, &quot;&quot;Datum&quot;&quot;, &quot;&quot;Schiesstag&quot;&quot;, &quot;&quot;Fleisch&quot;&quot;) VALUES (&quot;&amp; gSaison &amp;&quot;, {D &apos;&quot;&amp; sDatum &amp;&quot;&apos;}, &quot;&amp; nSchiesstag &amp;&quot;, &apos;&quot;&amp; bFleisch &amp;&quot;&apos;)&quot;
	Statement.executeUpdate(Query)

	REM ***** Trage Beginn der Saison in Tabelle &quot;Saison&quot; ein, wenn erster Schiesstag***** 
	If nSchiesstag = 1 Then
	
		Query = &quot;UPDATE &quot;&quot;Saison&quot;&quot; SET &quot;&quot;Beginn&quot;&quot; = {D &apos;&quot;&amp; sDatum &amp;&quot;&apos;} WHERE &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; AND &quot;&quot;Aktiv&quot;&quot; = TRUE&quot;
		Statement.executeUpdate(Query)
	
	End If

	REM ***** Setzte globale Variablen für Schiesstag *****
	gSchiesstag = nSchiesstag
	gFleisch = bFleisch

End Sub

REM ***** Die Aktion des Listeners für den Abbruch-Button
Sub PB2_Schiesstag_actionPerformed(oEvent2)

	REM *****Entfernen der Listener 
	oSchiesstagDialog.getControl(&quot;PB1&quot;).removeActionListener(oPBSchiesstagListener1)
	oSchiesstagDialog.getControl(&quot;PB2&quot;).removeActionListener(oPBSchiesstagListener2)
	
	REM *****Schliessen des Dialogs
	oSchiesstagDialog.EndExecute()

End Sub
</script:module>