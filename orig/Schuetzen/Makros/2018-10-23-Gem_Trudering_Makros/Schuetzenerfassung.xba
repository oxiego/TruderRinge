		.setPropertyValue(&quot;Align&quot;, 0)
		.setPropertyValue(&quot;VerticalAlign&quot;, 1)
		.setPropertyValue(&quot;FontEmphasisMark&quot;, 0)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;PositionX&quot;, Fontsize)
		.setPropertyValue(&quot;PositionY&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
		.setPropertyValue(&quot;Width&quot;, Fontsize * 5)
		.setPropertyValue(&quot;HelpText&quot;, &quot;Feld leer lassen, wenn 8-stellige Passnummer bekannt!&quot;)
	End With

	oDialogModel.insertByName(&quot;Label 1&quot;, oMod)

	REM ***** Text Feld erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlNumericFieldModel&quot;)
