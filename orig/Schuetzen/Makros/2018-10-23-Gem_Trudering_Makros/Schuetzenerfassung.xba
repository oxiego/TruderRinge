	End With

	oDialogModel.insertByName(&quot;Label 6&quot;, oMod)

	REM ***** Anzeige der ListBox vorbereiten *****
	If mSchuetze(4) = &quot;M&quot; Then
	
		value = 0

	ElseIf mSchuetze(4) = &quot;W&quot; Then
	
		value = 1
	Else
	
		value = -1
		
	End If
	
	REM ***** ListBox Feld erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlListBoxModel&quot;)
	With oMod
		.setPropertyValue(&quot;Name&quot;, &quot;Geschlecht&quot;)
		.setPropertyValue(&quot;Border&quot;, 2)
		.setPropertyValue(&quot;Align&quot;, 0)
