<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE script:module PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "module.dtd">
<script:module xmlns:script="http://openoffice.org/2000/script" script:name="Schuetzenerfassung" script:language="StarBasic">REM ***** Makros zur Erfassen von neuen Schuetzen *****

REM ***** Variablen für den Dialog *****
Private oPBSchuetzeListener1
Private oPBSchuetzeListener2
Private oSchuetzeDialog As Object

Private	mSchuetze(9) As Variant
Private bCancel As Boolean

REM ***** Makro für das Erfassen eines neuen Schuetzen *****
Sub Schuetzenerfassung

	REM ***** Rufe Makro zum Initialisieren des Array&apos;s auf *****
	Call Schuetzendaten_init()
	
	REM ***** Initialisiere Variable *****
	bCancel = FALSE

	REM ***** Rufe Dialog solange auf, bis Ende gedrückt wird *****
	Do

		REM ***** Dialog für das Erfassen eines neuen Schuetzen aufrufen *****
		Call Dialog_Schuetzenerfassung()

	Loop While NOT bCancel

	REM ***** Speichere Daten auf Disk *****
	&apos;DataSource.flush

End Sub

REM ***** Makro zur Eingabe der Schuetzendaten *****
Sub Dialog_Schuetzenerfassung

	Dim oDialogModel As Object
	Dim oWindow As Object
	Dim oMod As Object
	Dim oEvent1
	Dim oEvent2
	
	Dim value As Integer

	REM ***** Initialisierung der Eigenschaften des Dialogs *****
	oDialogModel = CreateUnoService(&quot;com.sun.star.awt.UnoControlDialogModel&quot;)
	With oDialogModel
		.setPropertyValue(&quot;Title&quot;, &quot;Schützendaten eingeben&quot;)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;PositionX&quot;, 50)
		.setPropertyValue(&quot;PositionY&quot;, 50 )
		.setPropertyValue(&quot;Width&quot;, Fontsize * 19)
		.setPropertyValue(&quot;Height&quot;, (Fontsize * 3) + (9 * (Fontsize + 5)))
	End With
	
	oSchuetzeDialog = CreateUnoService(&quot;com.sun.star.awt.UnoControlDialog&quot;)

	REM ***** Textlabel erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
	With oMod
		.setPropertyValue(&quot;Name&quot;, &quot;Label 1&quot;)
		.setPropertyValue(&quot;Label&quot;, &quot;Passnummer:&quot;)
