		.setPropertyValue(&quot;Dropdown&quot;, True)
		.setPropertyValue(&quot;SelectedItems&quot;,Array(value))
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;PositionX&quot;, (Fontsize * 7))
		.setPropertyValue(&quot;PositionY&quot;, Fontsize + (4 * (Fontsize + 5)))
