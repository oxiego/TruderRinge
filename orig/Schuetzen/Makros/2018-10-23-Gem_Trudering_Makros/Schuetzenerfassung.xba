	REM ***** Listener für den Speichern-Button *****
	oPBSchuetzeListener1 = createUnoListener(&quot;PB1_Schuetze_&quot;, &quot;com.sun.star.awt.XActionListener&quot;)
	oControl = oSchuetzeDialog.getControl(&quot;PB1&quot;)
	oControl.addActionListener(oPBSchuetzeListener1)
	
	REM ***** Listener für den Abbruch-Button *****
	oPBSchuetzeListener2 = createUnoListener(&quot;PB2_Schuetze_&quot;, &quot;com.sun.star.awt.XActionListener&quot;)
	oControl = oSchuetzeDialog.getControl(&quot;PB2&quot;)
	oControl.addActionListener(oPBSchuetzeListener2)
	
	REM ***** Mittels des Modells den Dialog anzeigen *****
	oWindow = CreateUnoService(&quot;com.sun.star.awt.Toolkit&quot;)
	oSchuetzeDialog.createPeer(oWindow, null)
	oSchuetzeDialog.execute()

End Sub

REM ***** Die Aktion des Listeners für den Speichern-Button *****
Sub PB1_Schuetze_actionPerformed(oEvent1)

	Dim oDialogField As Object

	REM ***** Entfernen der Listener *****
	oSchuetzeDialog.getControl(&quot;PB1&quot;).removeActionListener(oPBSchuetzeListener1)
	oSchuetzeDialog.getControl(&quot;PB2&quot;).removeActionListener(oPBSchuetzeListener2)

	REM ***** Schliessen des Dialogs *****
	oSchuetzeDialog.EndExecute()

	REM ***** Long-Feld im Dialog ansprechen *****
	oDialogField = oSchuetzeDialog.getControl(&quot;Passnummer&quot;)

	REM ***** Wert in Array speichern *****
	mSchuetze(0) = oDialogField.Value
	
	REM ***** Text-Feld im Dialog ansprechen *****
	oDialogField = oSchuetzeDialog.getControl(&quot;Vorname&quot;)

	REM ***** Wert in Array speichern *****
	mSchuetze(1) = oDialogField.Text
	
	REM ***** Text-Feld im Dialog ansprechen *****
	oDialogField = oSchuetzeDialog.getControl(&quot;Nachname&quot;)

	REM ***** Wert in Array speichern *****
	mSchuetze(2) = oDialogField.Text

	REM ***** Datum-Feld im Dialog ansprechen *****
	oDialogField = oSchuetzeDialog.getControl(&quot;Geburtsdatum&quot;)

	REM ***** Wert in Array speichern *****
	mSchuetze(3) = DateValue(oDialogField.Text)

	REM ***** ListBox-Feld im Dialog ansprechen *****
	oDialogField = oSchuetzeDialog.getControl(&quot;Geschlecht&quot;)

	REM ***** Wert in Array speichern *****
	mSchuetze(4) = oDialogField.SelectedItem
	
	REM ***** CheckBox-Feld im Dialog ansprechen *****
	oDialogField = oSchuetzeDialog.getControl(&quot;LG&quot;)

	REM ***** Wert in Array speichern *****
	mSchuetze(5) = oDialogField.State

	REM ***** CheckBox-Feld im Dialog ansprechen *****
	oDialogField = oSchuetzeDialog.getControl(&quot;LP&quot;)

	REM ***** Wert in Array speichern *****
	mSchuetze(6) = oDialogField.State

	REM ***** CheckBox-Feld im Dialog ansprechen *****
	oDialogField = oSchuetzeDialog.getControl(&quot;Fleisch&quot;)

	REM ***** Wert in Array speichern *****
	mSchuetze(7) = oDialogField.State

	REM ***** CheckBox-Feld im Dialog ansprechen *****
	oDialogField = oSchuetzeDialog.getControl(&quot;Hilfsmittel&quot;)

	REM ***** Wert in Array speichern *****
	mSchuetze(8) = oDialogField.State

	REM ***** CheckBox-Feld im Dialog ansprechen *****
	oDialogField = oSchuetzeDialog.getControl(&quot;Aktiv&quot;)

	REM ***** Wert in Array speichern *****
	mSchuetze(9) = oDialogField.State

	REM ***** Rufe Makro zum Prüfen der Daten ein *****
	Call Schuetzendaten_pruefen()
	
End Sub

REM ***** Die Aktion des Listeners für den Abbruch-Button *****
Sub PB2_Schuetze_actionPerformed(oEvent1)

	REM ***** Entfernen der Listener *****
	oSchuetzeDialog.getControl(&quot;PB1&quot;).removeActionListener(oPBSchuetzeListener1)
	oSchuetzeDialog.getControl(&quot;PB2&quot;).removeActionListener(oPBSchuetzeListener2)

	REM ***** Schliessen des Dialogs *****
	oSchuetzeDialog.EndExecute()

	REM ***** Setzte Variable zum Abbruch des Dialogs *****
	bCancel = TRUE

End Sub

REM ***** Makro zum Pruefen der eingegebenen Schützendaten *****
Sub Schuetzendaten_pruefen

	REM ***** Teste ob Feld leer ist und suche nach der niedrigsten SchuetzenID welche mit &apos;9&apos; beginnt *****
	REM ***** Schützennummern mit &apos;9&apos; am Anfang sind temporäre Nummern, welche verwendet werden, *****
	REM ***** richtige Passnummer bekannt ist *****
	If mSchuetze(0) = 0 Then

		Query = &quot;SELECT &quot;&quot;SchuetzenID&quot;&quot; FROM &quot;&quot;Schuetzen&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; LIKE &apos;9*&apos; ORDER BY &quot;&quot;SchuetzenID&quot;&quot; DESC&quot;
		ResultSet = Statement.executeQuery(Query)
		
		ResultSet.last()

		REM ***** Überprüfe, ob ein Ergebnis geliefert wurde *****
		If ResultSet.getrow() &gt; 0 Then

			REM ***** Schreibe Ergebnis in Variable *****
			mSchuetze(0) = ResultSet.getDouble(1) - 1

		Else

			REM ***** Schreibe Ergebnis in Variable *****
			mSchuetze(0) = 99999999

		End If

	REM ***** Überprüfe ob Passnummer bereits vergeben *****
	Else
	
		REM ***** Überprüfe Länge/Wert der Passnummer *****
		If Len(mSchuetze(0)) &lt;&gt; 8 Then
		
			MsgBox &quot;Passnummer falsch!&quot;, 16, &quot;Fehler&quot;

			REM ***** Beende Makro, wenn Fehler gefunden wurde *****
			Exit Sub

		Else

			Query = &quot;SELECT &quot;&quot;SchuetzenID&quot;&quot; FROM &quot;&quot;Schuetzen&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot; &amp; mSchuetze(0) &amp;&quot;&quot;
			ResultSet = Statement.executeQuery(Query)
			
			ResultSet.last()
	
			REM ***** Überprüfe, ob ein Ergebnis geliefert wurde *****
			If ResultSet.getrow() &gt; 0 Then
	
				MsgBox &quot;Passnummer bereits vergeben!&quot;, 16, &quot;Fehler&quot;
	
				REM ***** Beende Makro, wenn Fehler gefunden wurde *****
				Exit Sub

			End If

		End If
			
	End If

	REM ***** Überprüfe ob Feld befüllt *****
	If (mSchuetze(1) = &quot;&quot;) OR (mSchuetze(2) = &quot;&quot;) Then

		MsgBox &quot;Vorname / Nachname nicht befüllt!&quot;, 16, &quot;Fehler&quot;

		REM ***** Beende Makro, wenn Fehler gefunden wurde *****
		Exit Sub

	End If

	REM ***** Überprüfe ob Feld befüllt *****
	If mSchuetze(3) = &quot;&quot; Then

		MsgBox &quot;Geburtsdatum nicht befüllt!&quot;, 16, &quot;Fehler&quot;

		REM ***** Beende Makro, wenn Fehler gefunden wurde *****
		Exit Sub

	End If

	REM ***** Überprüfe ob Feld befüllt *****
	If (mSchuetze(4) &lt;&gt; &quot;M&quot;) AND (mSchuetze(4) &lt;&gt; &quot;W&quot;) Then

		MsgBox &quot;Kein Geschlecht ausgewählt!&quot;, 16, &quot;Fehler&quot;

		REM ***** Beende Makro, wenn Fehler gefunden wurde *****
		Exit Sub

	End If

	REM ***** Makro für das Speichern der Daten aufrufen *****
	Call Schuetzendaten_speichern()

	REM ***** Überprüfe ob eine laufende Saison vorhanden ist *****
	REM ***** Wenn Saison &gt; 0, dann laufende Saison vorhanden *****
	If gSaison &gt; 0 Then

		REM ***** Sicherheitsabfrage, ob Tagesauswertung wirklich durchgeführt werden soll *****
		If MsgBox (&quot;Laufende Saison gefunden!&quot;+ Chr(13) +&quot;Soll Klasseneinteilung durchgeführt werden?&quot;, 256 + 32 + 4, &quot;Hinweis&quot;) = 6 Then
	
			
		End If
	
	End If


End Sub

REM ***** Makro zum Speichern der Daten *****
Sub Schuetzendaten_speichern

	Dim sBirthday As String

	REM ***** Schreibe Daten in Tabelle &quot;Schuetzen&quot; *****
	Query = &quot;INSERT INTO &quot;&quot;Schuetzen&quot;&quot; (&quot;&quot;SchuetzenID&quot;&quot;,&quot;&quot;Vorname&quot;&quot;,&quot;&quot;Name&quot;&quot;,&quot;&quot;Geburtsdatum&quot;&quot;,&quot;&quot;Geschlecht&quot;&quot;,&quot;&quot;LG&quot;&quot;,&quot;&quot;LP&quot;&quot;,&quot;&quot;Fleisch&quot;&quot;,&quot;&quot;Hilfsmittel&quot;&quot;,&quot;&quot;Aktiv&quot;&quot;) VALUES (&apos;&quot;&amp; mSchuetze(0) &amp;&quot;&apos;, &apos;&quot;&amp; mSchuetze(1) &amp;&quot;&apos;, &apos;&quot;&amp; mSchuetze(2) &amp;&quot;&apos;, {D &apos;&quot;&amp; mSchuetze(3) &amp;&quot;&apos;}, &apos;&quot;&amp; mSchuetze(4) &amp;&quot;&apos;, &quot;&amp; mSchuetze(5) &amp;&quot;, &quot;&amp; mSchuetze(6) &amp;&quot;, &quot;&amp; mSchuetze(7) &amp;&quot;, &quot;&amp; mSchuetze(8) &amp;&quot;, &quot;&amp; mSchuetze(9) &amp;&quot;)&quot; 
	MsgBox Query
	Statement.executeUpdate(Query)

	REM ***** Setzte Variable zum Abbruch des Dialogs *****
	bCancel = TRUE

End Sub

REM ***** Makro zum Initialisieren des Arrays *****
Sub Schuetzendaten_init

	REM ***** Initialisiere Array *****
	mSchuetze(4) = &quot;&quot;
	mSchuetze(9) = 1

End Sub
</script:module>