	REM ***** CheckBox Feld erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlCheckBoxModel&quot;)
	With oMod
		.setPropertyValue(&quot;Name&quot;, &quot;LP&quot;)
		.setPropertyValue(&quot;Align&quot;, 0)
		.setPropertyValue(&quot;State&quot;, mSchuetze(6))
