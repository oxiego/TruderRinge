<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE script:module PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "module.dtd">
<script:module xmlns:script="http://openoffice.org/2000/script" script:name="Schuetzenbericht" script:language="StarBasic">REM ***** Makros zur Erzeugen der Tabelleneinträge für die Schützenberichte *****

Private sTyp As String					&apos;Private Variable für den Typ (LG/LP)

REM ***** Makro für das Erzeugen der LG Einträge für den Schützenbericht *****
Sub LG_Schuetzenbericht

	REM ***** Überprüfe ob eine laufende Saison vorhanden ist *****
	REM ***** Wenn Saison &gt; 0, dann laufende Saison vorhanden *****
	If getSaison() = 0 Then

		MsgBox &quot;Keine laufende Saison gefunden!&quot;, 16, &quot;Fehler&quot;

		REM ***** Beende Makro, wenn keine Saison gefunden wurde *****
		Exit Sub

	End If

	REM ***** Dialog für Auswahlmenü aufrufen
	Call Schuetzenbericht(&quot;LG&quot;)

End Sub

REM ***** Makro für das Erzeugen der LP Einträge für den Schützenbericht *****
Sub LP_Schuetzenbericht

	REM ***** Überprüfe ob eine laufende Saison vorhanden ist *****
	REM ***** Wenn Saison &gt; 0, dann laufende Saison vorhanden *****
	If gSaison = 0 Then

		MsgBox &quot;Keine laufende Saison gefunden!&quot;, 16, &quot;Fehler&quot;

		REM ***** Beende Makro, wenn keine Saison gefunden wurde *****
		Exit Sub

	End If

	REM ***** Dialog für Auswahlmenü aufrufen
	Call Schuetzenbericht(&quot;LP&quot;)

End Sub

REM ***** Hauptmakro für das Erzeugen der Einträge für den Schützenbericht *****
REM ***** Benötigt &quot;LG&quot;/&quot;LP&quot; als Übergabeparameter *****
Sub Schuetzenbericht(ByVal sTyp As String)

	Dim mSchuetze() As String
	Dim iZaehler As Integer
	Dim i As Integer

	REM ***** Tabelle LG/LP_Schuetzen_Bericht leeren *****
	Query = &quot;DELETE FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Schuetzen_Bericht&quot;&quot;&quot;
	Statement.executeUpdate(Query)

	Query = &quot;SELECT &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;SchuetzenID&quot;&quot;, &quot;&quot;Schuetzen&quot;&quot;.&quot;&quot;Name&quot;&quot;, &quot;&quot;Schuetzen&quot;&quot;.&quot;&quot;Vorname&quot;&quot;, &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;Klasse&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;, &quot;&quot;Schuetzen&quot;&quot; WHERE &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;SchuetzenID&quot;&quot; = &quot;&quot;Schuetzen&quot;&quot;.&quot;&quot;SchuetzenID&quot;&quot; AND &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot; 
	ResultSet = Statement.executeQuery(Query)

	ResultSet.last()
	iZaehler = ResultSet.getrow()

	If iZaehler &gt; 0 Then
	
		ReDim mSchuetze(iZaehler - 1,2)

		For i = 1 to iZaehler
	
			REM ***** Speichere Schuetzen in Array
			ResultSet.absolute(i)
	
			mSchuetze(i-1,0) = ResultSet.getInt(1)
			mSchuetze(i-1,1) = ResultSet.getString(3) + &quot; &quot; + ResultSet.getString(2)
			mSchuetze(i-1,2) = ResultSet.getString(4)

		Next i

		For i = 0 to iZaehler -1
	
			REM ***** Schreibe Schuetzen in Tabelle LG_Schuetzen_Bericht *****
			Query = &quot;INSERT INTO &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Schuetzen_Bericht&quot;&quot; (&quot;&quot;Saison&quot;&quot;, &quot;&quot;SchuetzenID&quot;&quot;, &quot;&quot;Name&quot;&quot;, &quot;&quot;Klasse&quot;&quot;) VALUES (&quot;&amp; gSaison &amp;&quot;, &quot;&amp; mSchuetze(i,0) &amp;&quot;, &apos;&quot;&amp; mSchuetze(i,1) &amp;&quot;&apos;, &apos;&quot;&amp; mSchuetze(i,2) &amp;&quot;&apos;)&quot;	
			Statement.executeUpdate(Query)


			REM ***** Kopiere Ergebnisse Vereinsmeisterschaft *****
			Query = &quot;SELECT &quot;&quot;Platz&quot;&quot;, &quot;&quot;Jahresschnitt&quot;&quot;, &quot;&quot;Vorjahr&quot;&quot;, &quot;&quot;Differenz&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Vereinsmeister&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i,0) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;	
			ResultSet = Statement.executeQuery(Query)
			
			ResultSet.last()
			If 	ResultSet.getrow() &gt; 0 Then
			
				Query = &quot;UPDATE &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Schuetzen_Bericht&quot;&quot; SET&quot;&quot;Platz_Vereinsmeister&quot;&quot; = &quot;&amp; ResultSet.getInt(1) &amp;&quot;, &quot;&quot;Jahresschnitt&quot;&quot; = &quot;&amp; Str(ResultSet.getDouble(2)) &amp;&quot;, &quot;&quot;Vorjahr&quot;&quot; = &quot;&amp; Str(ResultSet.getDouble(3)) &amp;&quot;, &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Schuetzen_Bericht&quot;&quot;.&quot;&quot;Differenz&quot;&quot; = &quot;&amp; Str(ResultSet.getDouble(4)) &amp;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i,0) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;	
				Statement.executeUpdate(Query)

			End If

			REM ***** Kopiere Ergebnisse Königsschiessen *****
			Query = &quot;SELECT &quot;&quot;Platz&quot;&quot;, &quot;&quot;Teiler&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Koenigsschiessen&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i,0) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;	
			ResultSet = Statement.executeQuery(Query)
			
			ResultSet.last()
			If 	ResultSet.getrow() &gt; 0 Then
			
				Query = &quot;UPDATE &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Schuetzen_Bericht&quot;&quot; SET &quot;&quot;Platz_Koenig&quot;&quot; = &quot;&amp; ResultSet.getInt(1) &amp;&quot;, &quot;&quot;Teiler_Koenig&quot;&quot; = &quot;&amp; Str(ResultSet.getDouble(2)) &amp;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i,0) &amp;&quot;&quot;	
				Statement.executeUpdate(Query)

			End If

			REM ***** Kopiere Ergebnisse Pokalteiler *****
			Query = &quot;SELECT &quot;&quot;Platz&quot;&quot;, &quot;&quot;Teiler&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Pokalteiler&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i,0) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;	
			ResultSet = Statement.executeQuery(Query)
			
			ResultSet.last()
			If 	ResultSet.getrow() &gt; 0 Then
			
				Query = &quot;UPDATE &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Schuetzen_Bericht&quot;&quot; SET &quot;&quot;Platz_Pokalteiler&quot;&quot; = &quot;&amp; ResultSet.getInt(1) &amp;&quot;, &quot;&quot;Teiler_Pokalteiler&quot;&quot; = &quot;&amp; Str(ResultSet.getDouble(2)) &amp;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i,0) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;	
				Statement.executeUpdate(Query)

			End If

			REM ***** Kopiere Geldpreise *****
			Query = &quot;SELECT &quot;&quot;Betrag&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Geldpreise_Saison&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i,0) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;
			ResultSet = Statement.executeQuery(Query)
			
			ResultSet.last()
			If 	ResultSet.getrow() &gt; 0 Then

				Query = &quot;UPDATE &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Schuetzen_Bericht&quot;&quot; SET &quot;&quot;Geldpreis&quot;&quot; = &quot;&amp; Str(ResultSet.getDouble(1)) &amp;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i,0) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;	
				Statement.executeUpdate(Query)

			End If

			REM ***** Überprüfe, ob der Schützenbericht für LG erstellt wird *****
			If sTyp = &quot;LG&quot; Then
		
				REM ***** Kopiere Ergebnisse Roehrner Wanderpokal *****
				Query = &quot;SELECT &quot;&quot;Platz&quot;&quot;, &quot;&quot;Tage&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Roehrner_WP&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i,0) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;	
				ResultSet = Statement.executeQuery(Query)
				
				ResultSet.last()
				If 	ResultSet.getrow() &gt; 0 Then
				
					Query = &quot;UPDATE &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Schuetzen_Bericht&quot;&quot; SET &quot;&quot;Platz_Roehrner&quot;&quot; = &quot;&amp; ResultSet.getInt(1) &amp;&quot;, &quot;&quot;Tage_Roehrner&quot;&quot; = &quot;&amp; ResultSet.getInt(2) &amp;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i,0) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;	
					Statement.executeUpdate(Query)
		
				End If
		
				REM ***** Kopiere Ergebnisse Schmankerlpokal *****
				Query = &quot;SELECT &quot;&quot;Platz&quot;&quot;, &quot;&quot;Teiler&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Schmankerlpokal&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i,0) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;	
				ResultSet = Statement.executeQuery(Query)
				
				ResultSet.last()
				If 	ResultSet.getrow() &gt; 0 Then
				
					Query = &quot;UPDATE &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Schuetzen_Bericht&quot;&quot; SET &quot;&quot;Platz_Schmankerlpokal&quot;&quot; = &quot;&amp; ResultSet.getInt(1) &amp;&quot;, &quot;&quot;Teiler_Schmankerlpokal&quot;&quot; = &quot;&amp; Str(ResultSet.getDouble(2)) &amp;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i,0) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;	
					Statement.executeUpdate(Query)
		
				End If
		
				REM ***** Kopiere Ergebnisse Diepold Wanderpokal *****
				Query = &quot;SELECT &quot;&quot;Platz&quot;&quot;, &quot;&quot;Teiler&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Diepold_WP&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i,0) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;	
				ResultSet = Statement.executeQuery(Query)
				
				ResultSet.last()
				If 	ResultSet.getrow() &gt; 0 Then
				
					Query = &quot;UPDATE &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Schuetzen_Bericht&quot;&quot; SET &quot;&quot;Platz_Diepold&quot;&quot; = &quot;&amp; ResultSet.getInt(1) &amp;&quot;, &quot;&quot;Teiler_Diepold&quot;&quot; = &quot;&amp; Str(ResultSet.getDouble(2)) &amp;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i,0) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;	
					Statement.executeUpdate(Query)
		
				End If
				
				REM ***** Kopiere Ergebnisse Fleischpreise *****
				Query = &quot;SELECT &quot;&quot;Platz1&quot;&quot;, &quot;&quot;Platz2_1&quot;&quot;, &quot;&quot;Platz2_2&quot;&quot;, &quot;&quot;Platz3_1&quot;&quot;, &quot;&quot;Platz3_2&quot;&quot; FROM &quot;&quot;Fleischpreise_Saison&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i,0) &amp;&quot;&quot;	
				ResultSet = Statement.executeQuery(Query)
				
				ResultSet.last()
				If 	ResultSet.getrow() &gt; 0 Then
		
					Query = &quot;UPDATE &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Schuetzen_Bericht&quot;&quot; SET &quot;&quot;Fleisch_Platz1&quot;&quot; = &apos;&quot;&amp; ResultSet.getString(1) &amp;&quot;&apos;, &quot;&quot;Fleisch_Platz2&quot;&quot; = &apos;&quot;&amp; ResultSet.getString(2) &amp;&quot; / &quot;&amp; ResultSet.getString(3) &amp;&quot;&apos;, &quot;&quot;Fleisch_Platz3&quot;&quot; = &apos;&quot;&amp; ResultSet.getString(4) &amp;&quot; / &quot;&amp; ResultSet.getString(5) &amp;&quot;&apos; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(i,0) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;	
					Statement.executeUpdate(Query)
		
				End If

			End If

		Next i

	End If

	MsgBox &quot;Tabelleneinträge für Schützenberichte wurden erstellt!&quot;, 64, &quot;Hinweis&quot;

	REM ***** Speichere Daten auf Disk *****
	&apos;DataSource.flush

End Sub
</script:module>