	REM ***** Textlabel erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
	With oMod
		.setPropertyValue(&quot;Border&quot;, 0)
		.setPropertyValue(&quot;Label&quot;, Format(mSchuetze(nSerien+7), &quot;##,##0.00&quot;))
		.setPropertyValue(&quot;Name&quot;, &quot;LabelJS2&quot;)
		.setPropertyValue(&quot;PositionX&quot;, INT(oDialogModel.Width / 2) + Fontsize)
		.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + INT((i + 1.5) * (Fontsize + 5)))
		.setPropertyValue(&quot;Align&quot;, 0)
