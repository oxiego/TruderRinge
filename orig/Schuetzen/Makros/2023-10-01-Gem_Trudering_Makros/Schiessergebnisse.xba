<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE script:module PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "module.dtd">
<script:module xmlns:script="http://openoffice.org/2000/script" script:name="Schiessergebnisse" script:language="StarBasic">REM ***** Makros zum Erfassen der Schiessergebnisse eines Schiesstages in der laufenden Saison*****

REM ***** Variablen für den Dialog *****
Private oPBResultListener1
Private oPBResultListener2
Private oPBResultListener3
Private oPBResultListener4
Private oPBResultListener5
Private oPBResultListener6
Private oPBTeilerListener1
Private oPBTeilerListener2

Private oResultDialog1 As Object
Private oResultDialog2 As Object
Private oResultDialog3 As Object
Private oTeilerDialog As Object

Private sTyp As String					&apos;Private Variable für den Typ (LG/LP)
Private nSerien As Integer
Private mSchuetze() As Variant
Private bFleisch As Boolean
Private bCancel As Boolean

REM ***** Makro zur Eingabe der LG Ergebnisse eines Schiesstages *****
Sub LG_Ergebnisse

	REM ***** Überprüfe ob eine laufende Saison vorhanden ist *****
	REM ***** Wenn Saison &gt; 0, dann laufende Saison vorhanden *****
	If getSaison() = 0 Then

		MsgBox &quot;Keine laufende Saison gefunden!&quot;, 16, &quot;Fehler&quot;

		REM ***** Beende Makro, wenn keine Saison gefunden wurde *****
		Exit Sub

	End If

	REM ***** Lies Datum des aktuellen Schiesstages aus *****
	Query = &quot;SELECT &quot;&quot;Datum&quot;&quot; FROM &quot;&quot;Schiesstage&quot;&quot; WHERE &quot;&quot;Schiesstag&quot;&quot; = &quot;&amp; gSchiesstag &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; &quot;
	ResultSet = Statement.executeQuery(Query)

	ResultSet.last()

	REM ***** Überprüfe, ob ein Ergebnis geliefert wurde *****
	If ResultSet.getrow() &gt; 0 Then

		REM ***** Überprüfe ob Datum Schiesstage != Tagesdatum *****
		If ResultSet.getString(1) &lt;&gt; sDatum Then

			MsgBox &quot;Es wurde noch kein Schiesstag begonnen!&quot;, 16, &quot;Fehler&quot;

			REM ***** Beende Makro, wenn für das heutige Datum noch kein Schiesstag begonnen wurde *****
			Exit Sub

		End If
	Else
	
		REM ***** Liefert kein Ergebnis beim ersten Schiesstag!!! *****
		MsgBox &quot;Es wurde noch kein Schiesstag begonnen!&quot;, 16, &quot;Fehler&quot;

		REM ***** Beende Makro, wenn für das heutige Datum noch kein Schiesstag begonnen wurde *****
		Exit Sub

	End If

	REM ***** Setzte Variable *****
	sTyp = &quot;LG&quot;

	REM ***** Initialisiere Variable *****
	bCancel = FALSE

	REM ***** Rufe Dialog solange auf, bis Ende gedrückt wird *****
	Do

		REM ***** Dialog für Eingabe Schützennummer aufrufen
		Call Dialog_Ergebnisse_Schuetzennummer()

	Loop While NOT bCancel

End Sub

REM ***** Makro zur Eingabe der LP Ergebnisse eines Schiesstages *****
Sub LP_Ergebnisse

	REM ***** Überprüfe ob eine laufende Saison vorhanden ist *****
	REM ***** Wenn Saison &gt; 0, dann laufende Saison vorhanden *****
	If getSaison() = 0 Then

		MsgBox &quot;Keine laufende Saison gefunden!&quot;, 16, &quot;Fehler&quot;

		REM ***** Beende Makro, wenn keine Saison gefunden wurde *****
		Exit Sub

	End If

	REM ***** Lies Datum des aktuellen Schiesstages aus *****
	Query = &quot;SELECT &quot;&quot;Datum&quot;&quot; FROM &quot;&quot;Schiesstage&quot;&quot; WHERE &quot;&quot;Schiesstag&quot;&quot; = &quot;&amp; gSchiesstag &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot; &quot;
	ResultSet = Statement.executeQuery(Query)

	ResultSet.last()

	REM ***** Überprüfe, ob ein Ergebnis geliefert wurde *****
	If ResultSet.getrow() &gt; 0 Then

		REM ***** Überprüfe ob Datum Schiesstage != Tagesdatum *****
		If ResultSet.getString(1) &lt;&gt; sDatum Then

			MsgBox &quot;Es wurde noch kein Schiesstag begonnen!&quot;, 16, &quot;Fehler&quot;

			REM ***** Beende Makro, wenn für das heutige Datum noch kein Schiesstag begonnen wurde *****
			Exit Sub

		End If
	Else
	
		REM ***** Liefert kein Ergebnis beim ersten Schiesstag!!! *****
		MsgBox &quot;Es wurde noch kein Schiesstag begonnen!&quot;, 16, &quot;Fehler&quot;

		REM ***** Beende Makro, wenn für das heutige Datum noch kein Schiesstag begonnen wurde *****
		Exit Sub

	End If

	REM ***** Setzte Variable *****
	sTyp = &quot;LP&quot;

	REM ***** Initialisiere Variable *****
	bCancel = FALSE

	REM ***** Rufe Dialog solange auf, bis Ende gedrückt wird *****
	Do

		REM ***** Dialog für Eingabe Schützennummer aufrufen
		Call Dialog_Ergebnisse_Schuetzennummer()

	Loop While NOT bCancel

End Sub

REM ***** Dialog für Eingabe der Schützennummer *****
Sub Dialog_Ergebnisse_Schuetzennummer

	Dim oDialogModel As Object
	Dim oWindow As Object
	Dim oMod As Object
	Dim oEvent1
	Dim oEvent2
	
	REM ***** Initialisierung der Eigenschaften des Dialogs *****
	oDialogModel = CreateUnoService(&quot;com.sun.star.awt.UnoControlDialogModel&quot;)
	With oDialogModel
		.setPropertyValue(&quot;PositionX&quot;, 270)
		.setPropertyValue(&quot;PositionY&quot;, 150 )
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Width&quot;, Fontsize * 11)
		.setPropertyValue(&quot;Height&quot;, Fontsize * 5)
		.setPropertyValue(&quot;Title&quot;, sTyp +&quot; Ergebnisse&quot;)
	End With
	
	oResultDialog1 = CreateUnoService(&quot;com.sun.star.awt.UnoControlDialog&quot;)
	
	REM ***** Textlabel erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
	With oMod
		.setPropertyValue(&quot;Label&quot;, &quot;Schützennummer:&quot;)
		.setPropertyValue(&quot;Name&quot;, &quot;LabelSN&quot;)
		.setPropertyValue(&quot;PositionX&quot;, Fontsize + 2)
		.setPropertyValue(&quot;PositionY&quot;, Fontsize)
		.setPropertyValue(&quot;Align&quot;, 0)
		.setPropertyValue(&quot;VerticalAlign&quot;, 1)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
		.setPropertyValue(&quot;Width&quot;, Fontsize * 10)
	End With
	
	oDialogModel.insertByName(&quot;LabelSN&quot;, oMod)
	
	REM ***** Text Feld erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlEditModel&quot;)
	With oMod
		.setPropertyValue(&quot;MaxTextLen&quot;, 2)
		.setPropertyValue(&quot;MultiLine&quot;, False)
		.setPropertyValue(&quot;Name&quot;, &quot;TF_SchuetzenNr&quot;)
		.setPropertyValue(&quot;PositionX&quot;, (Fontsize * 9) - 8)
		.setPropertyValue(&quot;PositionY&quot;, Fontsize)
		.setPropertyValue(&quot;Align&quot;, 2)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
		.setPropertyValue(&quot;Width&quot;, Fontsize + 6)
	End With
	
	oDialogModel.insertByName(&quot;TF_SchuetzenNr&quot;, oMod)
	
	REM ***** Pushbutton erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlButtonModel&quot;)
	With oMod
		.setPropertyValue(&quot;Label&quot;, &quot;Weiter&quot;)
		.setPropertyValue(&quot;Name&quot;, &quot;PB1&quot;)
		.setPropertyValue(&quot;PositionX&quot;, INT(oDialogModel.Width / 2 - (2 * Fontsize + 22)))
		.setPropertyValue(&quot;PositionY&quot;, oDialogModel.Height - (2 * Fontsize + 2))
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 7)
		.setPropertyValue(&quot;Width&quot;, 2 * Fontsize + 20)
	End With
	
	oDialogModel.insertByName(&quot;PB1&quot;, oMod)
	
	REM ***** Pushbutton erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlButtonModel&quot;)
	With oMod
		.setPropertyValue(&quot;Label&quot;, &quot;Ende&quot;)
		.setPropertyValue(&quot;Name&quot;, &quot;PB2&quot;)
		.setPropertyValue(&quot;PositionX&quot;, INT(oDialogModel.Width /2) + 2)
		.setPropertyValue(&quot;PositionY&quot;, oDialogModel.Height - (2 * Fontsize + 2))
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 7)
		.setPropertyValue(&quot;Width&quot;, 2 * Fontsize + 20)
	End With
	
	oDialogModel.insertByName(&quot;PB2&quot;, oMod)
	
	oResultDialog1.setModel(oDialogModel)
	
	REM ***** Listener für den Weiter-Button *****
	oPBResultListener1 = createUnoListener(&quot;PB1_Result_&quot;, &quot;com.sun.star.awt.XActionListener&quot;)
	oControl = oResultDialog1.getControl(&quot;PB1&quot;)
	oControl.addActionListener(oPBResultListener1)
	
	REM ***** Listener für den Ende-Button *****
	oPBResultListener2 = createUnoListener(&quot;PB2_Result_&quot;, &quot;com.sun.star.awt.XActionListener&quot;)
	oControl = oResultDialog1.getControl(&quot;PB2&quot;)
	oControl.addActionListener(oPBResultListener2)
	
	REM ***** Mittels des Modells den Dialog anzeigen *****
	oWindow = CreateUnoService(&quot;com.sun.star.awt.Toolkit&quot;)
	oResultDialog1.createPeer(oWindow, null)
	oResultDialog1.execute()

End Sub

REM ***** Die Aktion des Listeners für den Weiter-Button *****
Sub PB1_Result_actionPerformed(oEvent1)

	Dim oDialogField As Object
	Dim sName As String
	Dim sNumber As String
	Dim sSchuetzenID As String
		
	REM ***** Entfernen der Listener *****
	oResultDialog1.getControl(&quot;PB1&quot;).removeActionListener(oPBResultListener1)
	oResultDialog1.getControl(&quot;PB2&quot;).removeActionListener(oPBResultListener2)

	REM ***** Schliessen des Dialogs *****
	oResultDialog1.EndExecute()

	REM ***** Textfield-Status im Dialog ansprechen *****
	oDialogField = oResultDialog1.getControl(&quot;TF_SchuetzenNr&quot;)
	
	REM ***** Textfield im Dialog auslesen *****
	sNumber = oDialogField.Text

	REM ***** Suche Namen zu Schützennummer *****
	Query = &quot;SELECT &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;SchuetzenID&quot;&quot;, &quot;&quot;Schuetzen&quot;&quot;.&quot;&quot;Name&quot;&quot;, &quot;&quot;Schuetzen&quot;&quot;.&quot;&quot;Vorname&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;, &quot;&quot;Schuetzen&quot;&quot; WHERE &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;SchuetzenID&quot;&quot; = &quot;&quot;Schuetzen&quot;&quot;.&quot;&quot;SchuetzenID&quot;&quot; AND &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;Nummer&quot;&quot; = &apos;&quot;&amp; sNumber &amp;&quot;&apos; AND &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;
	ResultSet = Statement.executeQuery(Query)

	ResultSet.last()

	REM ***** Überprüfe, ob ein Ergebnis geliefert wurde *****
	If ResultSet.getrow() = 0 Then

		REM ***** Keine Schuetzen gefunden *****
		MsgBox &quot;Schützennummer &quot;&amp; sNumber &amp;&quot; ist nicht vergeben!&quot;, 16, &quot;Fehler&quot;

		REM ***** Beende Makro und kehre zum übergeordneten Makro zurück *****
		Exit Sub		
	Else

		sSchuetzenID = ResultSet.getString(1)

		REM ***** Überprüfe ob Schützennummer schon erfasst wurde *****
		Query = &quot;SELECT &quot;&quot;SchuetzenID&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Ergebnisse_Schiesstag&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; sSchuetzenID &amp;&quot; AND &quot;&quot;Schiesstag&quot;&quot; = &quot;&amp; gSchiesstag &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;

		ResultSet = Statement.executeQuery(Query)

		ResultSet.last()
		
		REM ***** Überprüfe, ob ein Ergebnis geliefert wurde *****
		If ResultSet.getrow() &gt; 0 Then
		
			REM ***** Für diesen Schuetzen wurde bereits ein Ergeniss erfasst *****
			MsgBox &quot;Schützennummer &quot;&amp; sNumber &amp;&quot; wurde bereits erfasst!&quot;, 64, &quot;Hinweis&quot;

			REM ***** Beende Makro und kehre zum übergeordneten Makro zurück *****
			Exit Sub		

		Else

			REM ***** Suche Namen zu SchützenID *****
			Query = &quot;SELECT &quot;&quot;Name&quot;&quot;, &quot;&quot;Vorname&quot;&quot; FROM &quot;&quot;Schuetzen&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; sSchuetzenID &amp;&quot;&quot;
			ResultSet = Statement.executeQuery(Query)
			
			ResultSet.last()
		
			REM ***** Schreibe Ergebnis in Variable *****
			sName = ResultSet.getString(1) &amp;&quot;, &quot;&amp; ResultSet.getString(2)
		
			REM ***** Initialisiere Variable *****
			bFleisch = FALSE
		
			If sTyp = &quot;LG&quot; AND gFleisch Then
			
				REM ***** Lies aus Tabelle, ob Fleisch in Schützenklasse geschossen wird *****
				Query = &quot;SELECT &quot;&quot;Fleischpreise_Schiesstag&quot;&quot;.&quot;&quot;Fleisch&quot;&quot; FROM &quot;&quot;Fleischpreise_Schiesstag&quot;&quot;, &quot;&quot;LG_Einteilung_Klassen&quot;&quot;, &quot;&quot;Saison&quot;&quot; WHERE &quot;&quot;Fleischpreise_Schiesstag&quot;&quot;.&quot;&quot;Klasse&quot;&quot; = &quot;&quot;LG_Einteilung_Klassen&quot;&quot;.&quot;&quot;Klasse&quot;&quot; AND &quot;&quot;LG_Einteilung_Klassen&quot;&quot;.&quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; sSchuetzenID &amp;&quot; AND &quot;&quot;Fleischpreise_Schiesstag&quot;&quot;.&quot;&quot;Schiesstag&quot;&quot; = &quot;&amp; gSchiesstag &amp;&quot; AND &quot;&quot;LG_Einteilung_Klassen&quot;&quot;.&quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;
				ResultSet = Statement.executeQuery(Query)
				
				ResultSet.last()
				
				REM ***** Überprüfe, ob ein Ergebnis geliefert wurde *****
				If ResultSet.getrow() &gt; 0 Then

					REM ***** Schreibe Ergebnis in Variable *****
					bFleisch = ResultSet.getBoolean(1)

				End If
		
			End If
		
			REM *****Lies aus Tabelle, wieviele Serien geschossen werden *****
			Query = &quot;SELECT &quot;&quot;Schuetzenklassen&quot;&quot;.&quot;&quot;Serien&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;, &quot;&quot;Schuetzenklassen&quot;&quot; WHERE &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;Klasse&quot;&quot; = &quot;&quot;Schuetzenklassen&quot;&quot;.&quot;&quot;Klasse&quot;&quot; AND &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;SchuetzenID&quot;&quot; = &apos;&quot;&amp; sSchuetzenID &amp;&quot;&apos; AND &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Einteilung_Klassen&quot;&quot;.&quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot;
			ResultSet = Statement.executeQuery(Query)
			
			ResultSet.last()
		
			REM ***** Schreibe Ergebnis in Variable *****
			nSerien = ResultSet.getInt(1)
		
			REM ***** Initialisiere Array für die Ergebnisse
			Redim mSchuetze(nSerien + 7)
			
			REM ***** Vorjahresschnitt des Schuetzen auslesen *****
			Query = &quot;SELECT &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Vorjahresschnitt&quot;&quot;, &quot;&quot;SchuetzenID&quot;&quot; FROM &quot;&quot;Schuetzen&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; sSchuetzenID &amp;&quot;&quot;
			ResultSet = Statement.executeQuery(Query)
			
			ResultSet.last()
		
			REM ***** Schreibe Daten in Array *****
			mSchuetze(0) = sSchuetzenID
			mSchuetze(1) = sNumber
			mSchuetze(2) = sName
			mSchuetze(3) = ResultSet.getDouble(1)
			
			REM ***** Rufe Dialog zur Eingabe des Ergebnisses auf ***** 
			Call Dialog_Ergebnis_Erfassen()

		End If
	End If

End Sub

REM ***** Die Aktion des Listeners für den Ende-Button *****
Sub PB2_Result_actionPerformed(oEvent2)

	REM ***** Entfernen der Listener *****
	oResultDialog1.getControl(&quot;PB1&quot;).removeActionListener(oPBResultListener1)
	oResultDialog1.getControl(&quot;PB2&quot;).removeActionListener(oPBResultListener2)

	REM ***** Schliessen des Dialogs *****
	oResultDialog1.EndExecute()

	REM ***** Setzte Variable zum Abbruch des Dialogs *****
	bCancel = TRUE

	REM ***** Speichere Daten auf Disk *****
	&apos;DataSource.flush
	
End Sub

REM ***** Dialog für die Erfassung der Schiessergebnisse *****
Sub Dialog_Ergebnis_Erfassen()

	Dim oDialogModel As Object
	Dim oWindow As Object
	Dim oMod As Object
	Dim oEvent1
	Dim oEvent2
	Dim i As Integer

	REM ***** Initialisierung der Eigenschaften des Dialogs *****
	oDialogModel = CreateUnoService(&quot;com.sun.star.awt.UnoControlDialogModel&quot;)
	With oDialogModel
		.setPropertyValue(&quot;PositionX&quot;, 270)
		.setPropertyValue(&quot;PositionY&quot;, 100 )
		.setPropertyValue(&quot;Width&quot;, Fontsize * 17)
		.setPropertyValue(&quot;Height&quot;, (Fontsize * 3) + ((nSerien + 7) * (Fontsize + 5)))
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Title&quot;, sTyp +&quot; Ergebnisse&quot;)
	End With
	
	oResultDialog2 = CreateUnoService(&quot;com.sun.star.awt.UnoControlDialog&quot;)
	
	REM ***** Textlabel erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
	With oMod
		.setPropertyValue(&quot;Border&quot;, 0)
		.setPropertyValue(&quot;Label&quot;, &quot;Nummer: &quot; &amp; mSchuetze(1))
		.setPropertyValue(&quot;Name&quot;, &quot;LabelID&quot;)
		.setPropertyValue(&quot;Align&quot;, 0)
		.setPropertyValue(&quot;VerticalAlign&quot;, 1)
		.setPropertyValue(&quot;PositionX&quot;, 10)
		.setPropertyValue(&quot;PositionY&quot;, Fontsize)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
		.setPropertyValue(&quot;Width&quot;, 50)
	End With
	
	oDialogModel.insertByName(&quot;LabelID&quot;, oMod)
	
	REM ***** Textlabel erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
	With oMod
		.setPropertyValue(&quot;Border&quot;, 0)
		.setPropertyValue(&quot;Label&quot;, mSchuetze(2))
		.setPropertyValue(&quot;Name&quot;, &quot;LabelName&quot;)
		.setPropertyValue(&quot;PositionX&quot;, oDialogModel.Width - 100)
		.setPropertyValue(&quot;PositionY&quot;, Fontsize)
		.setPropertyValue(&quot;Align&quot;, 2)
		.setPropertyValue(&quot;VerticalAlign&quot;, 1)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
		.setPropertyValue(&quot;Width&quot;, 90)
	End With
	
	oDialogModel.insertByName(&quot;LabelName&quot;, oMod)
	
	REM ***** Textlabel erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
	With oMod
		.setPropertyValue(&quot;Border&quot;, 0)
		.setPropertyValue(&quot;Label&quot;, &quot;Vorjahresschnitt: &quot;&amp; Format(mSchuetze(3), &quot;##,##0.00&quot;))
		.setPropertyValue(&quot;Name&quot;, &quot;LabelSchnitt&quot;)
		.setPropertyValue(&quot;PositionX&quot;, 10)
		.setPropertyValue(&quot;PositionY&quot;, INT(Fontsize * 2.5))
		.setPropertyValue(&quot;Align&quot;, 1)
		.setPropertyValue(&quot;VerticalAlign&quot;, 1)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
		.setPropertyValue(&quot;Width&quot;, oDialogModel.Width - 20)
	End With
	
	oDialogModel.insertByName(&quot;LabelSchnitt&quot;, oMod)
	
	REM ***** Linie erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedLineModel&quot;)
	With oMod
		.setPropertyValue(&quot;Name&quot;, &quot;FixedLabel1&quot;)
		.setPropertyValue(&quot;PositionX&quot;, 10)
		.setPropertyValue(&quot;PositionY&quot;, INT(Fontsize * 3.5))
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, 5)
		.setPropertyValue(&quot;Width&quot;, oDialogModel.Width - 20)
	End With
	
	oDialogModel.insertByName(&quot;FixedLabel1&quot;, oMod)
	
	For i = 1 to nSerien
			
		REM ***** Textlabel erzeugen *****
		oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
		With oMod
			.setPropertyValue(&quot;Border&quot;, 0)
			.setPropertyValue(&quot;Label&quot;, &quot;Serie &quot; &amp; i &amp; &quot;:&quot;)
			.setPropertyValue(&quot;Name&quot;, &quot;Label&quot; &amp; i)
			.setPropertyValue(&quot;PositionX&quot;, INT(oDialogModel.Width / 2) - (Fontsize * 3))
			.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + (i * (Fontsize + 5)))
			.setPropertyValue(&quot;Align&quot;, 2)
			.setPropertyValue(&quot;VerticalAlign&quot;, 1)
			.setPropertyValue(&quot;FontEmphasisMark&quot;, 0)
			.setPropertyValue(&quot;FontName&quot;, Font)
			.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
			.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
			.setPropertyValue(&quot;Width&quot;, Fontsize * 3)
		End With
	
		oDialogModel.insertByName(&quot;Label&quot; &amp; i, oMod)
	
		REM ***** Numerisches Feld erzeugen *****
		oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlNumericFieldModel&quot;)
		With oMod
			.setPropertyValue(&quot;Border&quot;, 2)
			.setPropertyValue(&quot;ValueMin&quot;, 0)
			.setPropertyValue(&quot;ValueMax&quot;, 100)
			.setPropertyValue(&quot;DecimalAccuracy&quot;, 0)
			.setPropertyValue(&quot;Name&quot;, &quot;EditMode&quot;&amp; i)
			.setPropertyValue(&quot;PositionX&quot;, INT(oDialogModel.Width / 2) + Fontsize)
			.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + (i * (Fontsize + 5)))
			.setPropertyValue(&quot;Align&quot;, 2)
			.setPropertyValue(&quot;FontName&quot;, Font)
			.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
			.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
