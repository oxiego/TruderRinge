		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 7)
		.setPropertyValue(&quot;Width&quot;, 2 * Fontsize + 20)
	End With
	
	oDialogModel.insertByName(&quot;PB3&quot;, oMod)
	
	REM ***** Pushbutton erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlButtonModel&quot;)
	With oMod
		.setPropertyValue(&quot;Label&quot;, &quot;Abbruch&quot;)
		.setPropertyValue(&quot;Name&quot;, &quot;PB4&quot;)
		.setPropertyValue(&quot;PositionX&quot;, INT(oDialogModel.Width / 2) + 2)
		.setPropertyValue(&quot;PositionY&quot;, oDialogModel.Height - (2 * Fontsize + 2))
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 7)
		.setPropertyValue(&quot;Width&quot;, 2 * Fontsize + 20)
	End With
	
	oDialogModel.insertByName(&quot;PB4&quot;, oMod)
	
	oResultDialog2.setModel(oDialogModel)
	
	REM ***** Listener für den Weiter-Button *****
	oPBResultListener3 = createUnoListener(&quot;PB3_Result_&quot;, &quot;com.sun.star.awt.XActionListener&quot;)
	oControl = oResultDialog2.getControl(&quot;PB3&quot;)
	oControl.addActionListener(oPBResultListener3)
	
	REM ***** Listener für den Abbruch-Button *****
	oPBResultListener4 = createUnoListener(&quot;PB4_Result_&quot;, &quot;com.sun.star.awt.XActionListener&quot;)
	oControl = oResultDialog2.getControl(&quot;PB4&quot;)
	oControl.addActionListener(oPBResultListener4)
	
	REM ***** Mittels des Modells den Dialog anzeigen *****
	oWindow = CreateUnoService(&quot;com.sun.star.awt.Toolkit&quot;)
	oResultDialog2.createPeer(oWindow, null)
	oResultDialog2.execute()

End Sub

REM ***** Die Aktion des Listeners für den Weiter-Button *****
Sub PB3_Result_actionPerformed(oEvent1)

	Dim oDialogField As Object
	Dim nSumme As Integer
	Dim sTeiler As String
	Dim iZaehler As Integer
	Dim i As Integer

	REM ***** Entfernen der Listener *****
	oResultDialog2.getControl(&quot;PB3&quot;).removeActionListener(oPBResultListener3)
	oResultDialog2.getControl(&quot;PB4&quot;).removeActionListener(oPBResultListener4)

	REM ***** Schliessen des Dialogs *****
	oResultDialog2.EndExecute()

	REM ***** Ergebnisvariable initialisieren *****
	nSumme = 0
	
	REM ***** Lies Ergebnis alle Serien aus und schreibe das Ergebnis in das Array *****
	For i = 1 to nSerien
	
		REM ***** Textfield-Status im Dialog ansprechen *****
		oDialogField = oResultDialog2.getControl(&quot;EditMode&quot;&amp; i)
	
		REM ***** Teste ob Feld leer ist
		If oDialogField.Text = &quot;&quot; Then

			REM ***** Schreibe 0 in das Array *****
			mSchuetze(i+3) = 0

		Else

			REM ***** Schreibe Ergebnis in das Array *****
			mSchuetze(i+3) = Int(oDialogField.Text)
		
		End If

		REM ***** Zähle Ergebnisse zusammen *****
		nSumme = nSumme + Int(oDialogField.Text)
	
	Next i

	REM ***** Schreibe Summe in das Array *****
	mSchuetze(nSerien+4) = nSumme

	REM ***** Rufe Ergebnis für Pokalteiler ab, wenn Luftpistole erfasst wurde *****
	REM ***** und wenn Luftgewehr AND kein Fleisch erfasst wird *****
	If sTyp &lt;&gt; &quot;LG&quot; OR bFleisch &lt;&gt; TRUE Then

		REM ***** Numerisches Feld für Pokalteiler im Dialog ansprechen *****
		oDialogField = oResultDialog2.getControl(&quot;EditModePokal&quot;)
		
		REM ***** Schreibe Pokalteiler in das Array *****
		mSchuetze(nSerien+5) = oDialogField.Value

		REM ***** Überprüfe, ob zulässige Werte eingegeben wurden *****
		If (mSchuetze(nSerien+5) = 0.0) OR (mSchuetze(nSerien+5) &gt; 999.9) Then

			sTeiler = Format(mSchuetze(nSerien+5), &quot;##,#0.0&quot;)

			If MsgBox (&quot;Bei Pokal wurde &apos;&quot;&amp; sTeiler &amp;&quot;&apos; eingegeben! Soll dieser Teiler übernommen werden?&quot;, 292) = 7 Then

				REM ***** Schreibe Eingabe in das Array *****
				Call Dialog_Teiler_Erfassen(&quot;Pokal&quot;)

			End If

		End If

	Else

		REM ***** Schreib leeren Wert in das Array, wenn kein Pokal geschossen wurde *****
		mSchuetze(nSerien+5) = NULL

	End If
	
	REM ***** Rufe Ergebnis für Programm_2 ab, wenn Luftgewehr erfasst wurde *****
	If sTyp = &quot;LG&quot; Then

		REM ***** Numerisches Feld für Programm_2 im Dialog ansprechen *****
		oDialogField = oResultDialog2.getControl(&quot;EditModeSP&quot;)
		
		REM ***** Schreibe Programm_2 in das Array *****
		mSchuetze(nSerien+6) = oDialogField.Value
	
		REM ***** Überprüfe, ob zulässige Werte eingegeben wurden *****
		If (mSchuetze(nSerien+6) = 0.0) OR (mSchuetze(nSerien+6) &gt; 999.9) Then
	
			sTeiler = Format(mSchuetze(nSerien+6), &quot;##,#0.0&quot;)
	
			If MsgBox (&quot;Bei Programm_2 wurde &apos;&quot;&amp; sTeiler &amp;&quot;&apos; eingegeben! Soll dieser Teiler übernommen werden?&quot;, 292) = 7 Then
	
				REM ***** Schreibe Eingabe in das Array *****
				Call Dialog_Teiler_Erfassen(&quot;2.Prog&quot;)
	
			End If
	
		End If

	Else

		REM ***** Setzte Wert auf 0.0 wenn Luftpistole erfasst wurde *****
		mSchuetze(nSerien+6) = 0.0

	End If
	
	REM ***** Suche alle Schiessergebnisse des Schuetzen in laufender Saison *****
	Query = &quot;SELECT &quot;&quot;Ergebnis&quot;&quot; FROM &quot;&quot;&quot;&amp; sTyp &amp;&quot;_Ergebnisse_Schiesstag&quot;&quot; WHERE &quot;&quot;SchuetzenID&quot;&quot; = &quot;&amp; mSchuetze(0) &amp;&quot; AND &quot;&quot;Saison&quot;&quot; = &quot;&amp; gSaison &amp;&quot;&quot; 
	ResultSet = Statement.executeQuery(Query)
	
	ResultSet.last()

	iZaehler = ResultSet.getrow()
	
	REM ***** Zähle die Ergebnisse zu dem aktuellen Ergenis hinzu *****
	For i = 1 to iZaehler
	
		ResultSet.absolute(i)

		nSumme = nSumme + ResultSet.getInt(1)
	
	Next i

	mSchuetze(nSerien+7) = nSumme / (iZaehler + 1)

	REM ***** Prüfe ob Ergebnis &lt; Vorjahresschnitt *****
	If mSchuetze(nSerien+4) &lt; mSchuetze(3) Then
	
		REM ***** Rufe Dialog auf, dass der Vorjahresschnitt nicht erreicht wurde *****
		Call Dialog_Vorjahresschnitt()
	
	End If
	
	REM ***** Prüfe of Schnapszahl geschossen wurde *****
	If mSchuetze(nSerien+4) = 333 Then
	
		REM ***** Rufe Dialog auf, dass Schnappszahl geschossen wurde *****
		Call Dialog_Schnapszahl()

	End If

	REM ***** Dialog für Anzeige des Schiessergebnisses aufrufen *****
	Call Dialog_Ergebnis_Anzeigen()

End Sub

REM ***** Dialog für die Anzeige, dass Schnappszahl geschossen wurde *****
Sub Dialog_Schnapszahl

	REM ***** Messagebox ausgeben *****
	Beep
	MsgBox &quot;Das Auswerte-Team bedankt sich für den Schnaps!&quot;, 64 , &quot;Schnapszahl (333)&quot;

End Sub



REM ***** Die Aktion des Listeners für den Abbruch-Button *****
Sub PB4_Result_actionPerformed(oEvent2)

	REM ***** Entfernen der Listener *****
	oResultDialog2.getControl(&quot;PB3&quot;).removeActionListener(oPBResultListener3)
	oResultDialog2.getControl(&quot;PB4&quot;).removeActionListener(oPBResultListener4)

	REM ***** Schliessen des Dialogs *****
	oResultDialog2.EndExecute()

End Sub

REM ***** Dialog für die Anzeige des Schiessergebnisses *****
Sub Dialog_Ergebnis_Anzeigen

	Dim oDialogModel As Object
	Dim oWindow As Object
	Dim oMod As Object
	Dim oEvent1
	Dim oEvent2

	REM ***** Initialisierung der Eigenschaften des Dialogs *****
	oDialogModel = CreateUnoService(&quot;com.sun.star.awt.UnoControlDialogModel&quot;)
	With oDialogModel
		.setPropertyValue(&quot;PositionX&quot;, 270)
		.setPropertyValue(&quot;PositionY&quot;, 100 )
		.setPropertyValue(&quot;Width&quot;, Fontsize * 17)
		.setPropertyValue(&quot;Height&quot;, (Fontsize * 3) + ((nSerien + 7) * (Fontsize + 5)))
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Title&quot;, sTyp +&quot; Ergebnisse&quot;)
	End With
	
	oResultDialog3 = CreateUnoService(&quot;com.sun.star.awt.UnoControlDialog&quot;)
	
	REM ***** Textlabel erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
	With oMod
		.setPropertyValue(&quot;Border&quot;, 0)
		.setPropertyValue(&quot;Label&quot;, &quot;Nummer: &quot; &amp; mSchuetze(1))
		.setPropertyValue(&quot;Name&quot;, &quot;LabelID&quot;)
		.setPropertyValue(&quot;Align&quot;, 0)
		.setPropertyValue(&quot;VerticalAlign&quot;, 1)
		.setPropertyValue(&quot;PositionX&quot;, 10)
		.setPropertyValue(&quot;PositionY&quot;, Fontsize)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
		.setPropertyValue(&quot;Width&quot;, 50)
	End With
	
	oDialogModel.insertByName(&quot;LabelID&quot;, oMod)
	
	REM ***** Textlabel erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
	With oMod
		.setPropertyValue(&quot;Border&quot;, 0)
		.setPropertyValue(&quot;Label&quot;, mSchuetze(2))
		.setPropertyValue(&quot;Name&quot;, &quot;LabelName&quot;)
		.setPropertyValue(&quot;PositionX&quot;, oDialogModel.Width - 100)
		.setPropertyValue(&quot;PositionY&quot;, Fontsize)
		.setPropertyValue(&quot;Align&quot;, 2)
		.setPropertyValue(&quot;VerticalAlign&quot;, 1)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
		.setPropertyValue(&quot;Width&quot;, 90)
	End With
	
	oDialogModel.insertByName(&quot;LabelName&quot;, oMod)
	
	REM ***** Textlabel erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
	With oMod
		.setPropertyValue(&quot;Border&quot;, 0)
		.setPropertyValue(&quot;Label&quot;, &quot;Vorjahresschnitt: &quot;&amp; Format(mSchuetze(3), &quot;##,##0.00&quot;))
		.setPropertyValue(&quot;Name&quot;, &quot;LabelSchnitt&quot;)
		.setPropertyValue(&quot;PositionX&quot;, 10)
		.setPropertyValue(&quot;PositionY&quot;, INT(Fontsize * 2.5))
		.setPropertyValue(&quot;Align&quot;, 1)
		.setPropertyValue(&quot;VerticalAlign&quot;, 1)
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
		.setPropertyValue(&quot;Width&quot;, oDialogModel.Width - 20)
	End With
	
	oDialogModel.insertByName(&quot;LabelSchnitt&quot;, oMod)
	
	REM ***** Linie erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedLineModel&quot;)
	With oMod
		.setPropertyValue(&quot;Name&quot;, &quot;FixedLabel1&quot;)
		.setPropertyValue(&quot;PositionX&quot;, 10)
		.setPropertyValue(&quot;PositionY&quot;, INT(Fontsize * 3.5))
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, 5)
		.setPropertyValue(&quot;Width&quot;, oDialogModel.Width - 20)
	End With
	
	oDialogModel.insertByName(&quot;FixedLabel1&quot;, oMod)
	
	For i = 1 to nSerien
			
		REM ***** Textlabel erzeugen *****
		oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
		With oMod
			.setPropertyValue(&quot;Border&quot;, 0)
			.setPropertyValue(&quot;Label&quot;, &quot;Serie &quot; &amp; i &amp; &quot;:&quot;)
			.setPropertyValue(&quot;Name&quot;, &quot;Label&quot; &amp; i)
			.setPropertyValue(&quot;PositionX&quot;, INT(oDialogModel.Width / 2) - (Fontsize * 3))
			.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + (i * (Fontsize + 5)))
			.setPropertyValue(&quot;Align&quot;, 2)
			.setPropertyValue(&quot;VerticalAlign&quot;, 1)
			.setPropertyValue(&quot;FontEmphasisMark&quot;, 0)
			.setPropertyValue(&quot;FontName&quot;, Font)
			.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
			.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
			.setPropertyValue(&quot;Width&quot;, Fontsize * 3)
		End With
	
		oDialogModel.insertByName(&quot;Label&quot; &amp; i, oMod)
	
		REM ***** Textlabel erzeugen *****
		oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
		With oMod
			.setPropertyValue(&quot;Border&quot;, 0)
			.setPropertyValue(&quot;Label&quot;, Str(mSchuetze(i+3)))
			.setPropertyValue(&quot;Name&quot;, &quot;EditMode&quot;&amp; i)
			.setPropertyValue(&quot;PositionX&quot;, INT(oDialogModel.Width / 2) + Fontsize)
			.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + (i * (Fontsize + 5)))
			.setPropertyValue(&quot;Align&quot;, 2)
			.setPropertyValue(&quot;VerticalAlign&quot;, 1)
			.setPropertyValue(&quot;FontName&quot;, Font)
			.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
			.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
			.setPropertyValue(&quot;Width&quot;, 14)
		End With
	
		oDialogModel.insertByName(&quot;EditMode&quot;&amp; i, oMod)
					
	Next i
	
	REM ***** Linie erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedLineModel&quot;)
	With oMod
		.setPropertyValue(&quot;Name&quot;, &quot;FixedLabel2&quot;)
		.setPropertyValue(&quot;PositionX&quot;, INT(oDialogModel.Width / 2) - (Fontsize * 4))
		.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + (i * (Fontsize + 5)))
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, 5)
		.setPropertyValue(&quot;Width&quot;, Fontsize * 8)
	End With
	
	oDialogModel.insertByName(&quot;FixedLabel2&quot;, oMod)
	
	REM ***** Textlabel erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
	With oMod
		.setPropertyValue(&quot;Border&quot;, 0)
		.setPropertyValue(&quot;Label&quot;, &quot;Ergebnis:&quot;)
