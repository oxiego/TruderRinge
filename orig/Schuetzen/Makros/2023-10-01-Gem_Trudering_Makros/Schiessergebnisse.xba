			.setPropertyValue(&quot;PositionX&quot;, INT(oDialogModel.Width / 2) - (Fontsize * 7))
			.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + ((i + 3) * (Fontsize + 5)))
			.setPropertyValue(&quot;Align&quot;, 2)
			.setPropertyValue(&quot;VerticalAlign&quot;, 1)
			.setPropertyValue(&quot;FontName&quot;, Font)
			.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
			.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
			.setPropertyValue(&quot;Width&quot;, Fontsize * 3)
		End With
	
		oDialogModel.insertByName(&quot;LabelPokal&quot;, oMod)
	
		REM ***** Textlabel erzeugen *****
		oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
		With oMod
			.setPropertyValue(&quot;Label&quot;, Format(mSchuetze(nSerien+5), &quot;##,#0.0&quot;))
			.setPropertyValue(&quot;Name&quot;, &quot;EditModePokal&quot;)
			.setPropertyValue(&quot;PositionX&quot;, INT(oDialogModel.Width / 2) - (Fontsize * 4))
			.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + ((i + 3) * (Fontsize + 5)))
			.setPropertyValue(&quot;Align&quot;, 2)
			.setPropertyValue(&quot;VerticalAlign&quot;, 1)
			.setPropertyValue(&quot;FontName&quot;, Font)
			.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
			.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
			.setPropertyValue(&quot;Width&quot;, Fontsize * 3)
		End With
	
		oDialogModel.insertByName(&quot;EditModePokal&quot;, oMod)
	
	End If
	
	REM ***** Rufe Ergebnis für Programm_2 an, wenn Luftgewehr erfasst wurde *****
	If sTyp = &quot;LG&quot; Then

		REM ***** Textlabel erzeugen *****
		oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
		With oMod
			.setPropertyValue(&quot;Border&quot;, 0)
			.setPropertyValue(&quot;Label&quot;, &quot;2.Prog: &quot;)
			.setPropertyValue(&quot;Name&quot;, &quot;LabelSP&quot;)
			.setPropertyValue(&quot;PositionX&quot;, INT(oDialogModel.Width / 2))
			.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + ((i + 3) * (Fontsize + 5)))
			.setPropertyValue(&quot;Align&quot;, 2)
			.setPropertyValue(&quot;VerticalAlign&quot;, 1)
			.setPropertyValue(&quot;FontName&quot;, Font)
			.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
			.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
			.setPropertyValue(&quot;Width&quot;, Fontsize * 3)
		End With
		
		oDialogModel.insertByName(&quot;LabelSP&quot;, oMod)
		
		REM ***** Textlabel erzeugen *****
		oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlFixedTextModel&quot;)
		With oMod
			.setPropertyValue(&quot;Label&quot;, Format(mSchuetze(nSerien+6), &quot;##,#0.0&quot;))
			.setPropertyValue(&quot;Name&quot;, &quot;EditModeSP&quot;)
			.setPropertyValue(&quot;PositionX&quot;, INT(oDialogModel.Width / 2) + (Fontsize * 3))
			.setPropertyValue(&quot;PositionY&quot;, (Fontsize * 3) + ((i + 3) * (Fontsize + 5)))
			.setPropertyValue(&quot;Align&quot;, 2)
			.setPropertyValue(&quot;VerticalAlign&quot;, 1)
			.setPropertyValue(&quot;FontName&quot;, Font)
			.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
			.setPropertyValue(&quot;Height&quot;, Fontsize + 2)
			.setPropertyValue(&quot;Width&quot;, Fontsize * 3)
		End With
		
		oDialogModel.insertByName(&quot;EditModeSP&quot;, oMod)
	
	End If
	
	REM ***** Pushbutton erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlButtonModel&quot;)
	With oMod
		.setPropertyValue(&quot;Label&quot;, &quot;Speichern&quot;)
		.setPropertyValue(&quot;Name&quot;, &quot;PB5&quot;)
		.setPropertyValue(&quot;PositionX&quot;, INT(oDialogModel.Width / 2 - (2 * Fontsize + 22)))
		.setPropertyValue(&quot;PositionY&quot;, oDialogModel.Height - (2 * Fontsize + 2))
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 7)
		.setPropertyValue(&quot;Width&quot;, 2 * Fontsize + 20)
	End With
	
	oDialogModel.insertByName(&quot;PB5&quot;, oMod)
	
	REM ***** Pushbutton erzeugen *****
	oMod = oDialogModel.createInstance(&quot;com.sun.star.awt.UnoControlButtonModel&quot;)
	With oMod
		.setPropertyValue(&quot;Label&quot;, &quot;Abbruch&quot;)
		.setPropertyValue(&quot;Name&quot;, &quot;PB6&quot;)
		.setPropertyValue(&quot;PositionX&quot;, INT(oDialogModel.Width / 2) + 2)
		.setPropertyValue(&quot;PositionY&quot;, oDialogModel.Height - (2 * Fontsize + 2))
		.setPropertyValue(&quot;FontName&quot;, Font)
		.setPropertyValue(&quot;FontHeight&quot;, Fontsize)
		.setPropertyValue(&quot;Height&quot;, Fontsize + 7)
		.setPropertyValue(&quot;Width&quot;, 2 * Fontsize + 20)
	End With
	
	oDialogModel.insertByName(&quot;PB6&quot;, oMod)
	
	oResultDialog3.setModel(oDialogModel)
	
	REM ***** Listener für den Speichern-Button *****
	oPBResultListener5 = createUnoListener(&quot;PB5_Result_&quot;, &quot;com.sun.star.awt.XActionListener&quot;)
	oControl = oResultDialog3.getControl(&quot;PB5&quot;)
	oControl.addActionListener(oPBResultListener5)
	
	REM ***** Listener für den Abbruch-Button *****
	oPBResultListener6 = createUnoListener(&quot;PB6_Result_&quot;, &quot;com.sun.star.awt.XActionListener&quot;)
	oControl = oResultDialog3.getControl(&quot;PB6&quot;)
	oControl.addActionListener(oPBResultListener6)
	
	REM ***** Mittels des Modells den Dialog anzeigen *****
	oWindow = CreateUnoService(&quot;com.sun.star.awt.Toolkit&quot;)
	oResultDialog3.createPeer(oWindow, null)
	oResultDialog3.execute()

End Sub

REM ***** Die Aktion des Listeners für den Speichern-Button *****
Sub PB5_Result_actionPerformed(oEvent1)

	Dim i As Integer

	REM ***** Entfernen der Listener *****
	oResultDialog3.getControl(&quot;PB5&quot;).removeActionListener(oPBResultListener5)
	oResultDialog3.getControl(&quot;PB6&quot;).removeActionListener(oPBResultListener6)

	REM ***** Schliessen des Dialogs *****
	oResultDialog3.EndExecute()

	REM ***** Die folgenden Zeilen baut die Query für das Schreiben der Ergebnisse in die Tabelle zusammen *****

	REM ***** Wurde LG Ergenis erfasst? *****
	If sTyp = &quot;LG&quot; Then
	
		REM ***** Wurde Fleisch geschossen? *****
		If bFleisch Then

			Query = &quot;INSERT INTO &quot;&quot;LG_Ergebnisse_Schiesstag&quot;&quot; (&quot;&quot;Saison&quot;&quot;, &quot;&quot;Schiesstag&quot;&quot;, &quot;&quot;SchuetzenID&quot;&quot;, &quot;&quot;Serie1&quot;&quot;, &quot;&quot;Serie2&quot;&quot;, &quot;&quot;Serie3&quot;&quot;, &quot;&quot;Serie4&quot;&quot;, &quot;&quot;Ergebnis&quot;&quot;, &quot;&quot;Programm_2&quot;&quot;) VALUES (&quot;&amp; gSaison &amp;&quot;, &quot;&amp; gSchiesstag &amp;&quot;, &quot;&amp; mSchuetze(0) &amp;&quot;&quot;

		Else

			Query = &quot;INSERT INTO &quot;&quot;LG_Ergebnisse_Schiesstag&quot;&quot; (&quot;&quot;Saison&quot;&quot;, &quot;&quot;Schiesstag&quot;&quot;, &quot;&quot;SchuetzenID&quot;&quot;, &quot;&quot;Serie1&quot;&quot;, &quot;&quot;Serie2&quot;&quot;, &quot;&quot;Serie3&quot;&quot;, &quot;&quot;Serie4&quot;&quot;, &quot;&quot;Ergebnis&quot;&quot;, &quot;&quot;Pokal&quot;&quot;, &quot;&quot;Programm_2&quot;&quot;) VALUES (&quot;&amp; gSaison &amp;&quot;, &quot;&amp; gSchiesstag &amp;&quot;, &quot;&amp; mSchuetze(0) &amp;&quot;&quot;

		End If

	Else	

		Query = &quot;INSERT INTO &quot;&quot;LP_Ergebnisse_Schiesstag&quot;&quot; (&quot;&quot;Saison&quot;&quot;, &quot;&quot;Schiesstag&quot;&quot;, &quot;&quot;SchuetzenID&quot;&quot;, &quot;&quot;Serie1&quot;&quot;, &quot;&quot;Serie2&quot;&quot;, &quot;&quot;Serie3&quot;&quot;, &quot;&quot;Serie4&quot;&quot;, &quot;&quot;Ergebnis&quot;&quot;, &quot;&quot;Pokal&quot;&quot;) VALUES (&quot;&amp; gSaison &amp;&quot;, &quot;&amp; gSchiesstag &amp;&quot;, &quot;&amp; mSchuetze(0) &amp;&quot;&quot;

	End If

	REM ***** Query für Luftgewehr *****
	If sTyp = &quot;LG&quot; Then

		REM ***** Ergebnis der Serien *****
		For i = 1 to nSerien
	
			Query = Query &amp; &quot;, &quot;&amp; mSchuetze(i+3)
	
		Next i

		REM ***** Fülle restliche Serien auf, falls weniger als 4 Serien geschossen werden *****
		For i = nSerien + 1  to 4

			Query = Query &amp; &quot;, 00&quot;

		Next i

	REM ***** Query für Luftpistole *****
	Else
	
		For i = 1 to nSerien
	
			Query = Query &amp; &quot;, &quot;&amp; mSchuetze(i+3) + mSchuetze(i+4)
			i = i + 1

		Next i

		REM ***** Fülle restliche Serien auf, falls weniger als 8 Serien geschossen werden *****
		For i = nSerien / 2 + 1  to 4

			Query = Query &amp; &quot;, 00&quot;

		Next i

	End If

	REM ***** Ergebnis Summe *****
	Query = Query &amp; &quot;, &quot;&amp; mSchuetze(nSerien+4)

	REM ***** Pokalteiler *****
	If Not IsNull(mSchuetze(nSerien+5)) Then
		Query = Query &amp; &quot;, &quot;&amp; Str(mSchuetze(nSerien+5))
	End If

	REM ***** Programm_2 *****
	If sTyp = &quot;LG&quot; Then
		Query = Query &amp; &quot;, &quot;&amp; Str(mSchuetze(nSerien+6))
	End If

	REM ***** Schließe Query *****
	Query = Query &amp; &quot;)&quot;
	
	REM ***** Gibt die Query zum Überprüfen auf dem Bildschirm aus *****
&apos;	MsgBox Query
	
	REM ***** Schreibe Daten in Tabelle &quot;LG/LP_Ergebnisse_Schiesstag&quot; *****
	Statement.executeUpdate(Query)

	REM ***** Speichere Daten auf Disk *****
	DataSource.flush

End Sub

REM ***** Die Aktion des Listeners für den Abbruch-Button *****
